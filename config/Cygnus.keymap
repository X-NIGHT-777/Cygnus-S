#define ZMK_POINTING_DEFAULT_SCRL_VAL 120    // default: 10

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define L_QWERTY_DEFAULT           0
#define L_NUM_DEFAULT              1
#define L_ARROW_DEFAULT            2
#define L_MOUSE_DEFAULT            3
#define L_SCROLL_DEFAULT           4
#define L_FUNCTION_DEFAULT         5
#define L_BT_SETTING               6

// 珈琲配列
#define L_COFFEE                   7
#define L_QWERTY_RIGHT             8
#define L_QWERTY_LEFT              9
#define L_NUMBER                  10
#define L_SIMBOL                  11
#define L_ARROW                   12
#define L_FUNCTION                13
#define L_TRACKBALL               14 
#define L_SCROLL                  15

// マウスレイヤー
#define L_MOUSE                   16
#define L_MOUSE_SLOW              17
#define L_MOUSE_FAST              18

// カーソル速度（標準は MOVE_UP 等の 600）
#define SLOW_UP     MOVE_Y(-200)
#define SLOW_DOWN   MOVE_Y(200)
#define SLOW_LEFT   MOVE_X(-200)
#define SLOW_RIGHT  MOVE_X(200)

#define FAST_UP     MOVE_Y(-1800)
#define FAST_DOWN   MOVE_Y(1800)
#define FAST_LEFT   MOVE_X(-1800)
#define FAST_RIGHT  MOVE_X(1800)



&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

/ {



    combos {
        compatible = "zmk,combos";

    // ---- あ行 (5) ----
        combo_i {
            timeout-ms    = <50>;
            key-positions = <5 40>;             // あ(5) + ENTER → い
            bindings      = <&kp E>;
            layers        = <L_COFFEE>;
        };
        combo_u {
            timeout-ms    = <50>;
            key-positions = <5 20>;             // あ(5) + INT6  → う
            bindings      = <&kp N4>;
            layers        = <L_COFFEE>;
        };
        combo_e {
            timeout-ms    = <50>;
            key-positions = <5 41>;             // あ(5) + SPACE → え
            bindings      = <&kp N5>;
            layers        = <L_COFFEE>;
        };
        combo_o {
            timeout-ms    = <50>;
            key-positions = <5 32>;             // あ(5) + 。    → お
            bindings      = <&kp N6>;
            layers        = <L_COFFEE>;
        };

    // ---- か行 (6) ----
        combo_ki {
            timeout-ms    = <50>;
            key-positions = <6 40>;             // か(6) + ENTER → き
            bindings      = <&kp G>;
            layers        = <L_COFFEE>;
        };
        combo_ku {
            timeout-ms    = <50>;
            key-positions = <6 20>;             // か(6) + INT6  → く
            bindings      = <&kp H>;
            layers        = <L_COFFEE>;
        };
        combo_ke {
            timeout-ms    = <50>;
            key-positions = <6 41>;             // か(6) + SPACE → け
            bindings      = <&kp SQT>;
            layers        = <L_COFFEE>;
        };
        combo_ko {
            timeout-ms    = <50>;
            key-positions = <6 32>;             // か(6) + 。    → こ
            bindings      = <&kp B>;
            layers        = <L_COFFEE>;
        };

    // ---- さ行 (7) ----
        combo_shi {
            timeout-ms    = <50>;
            key-positions = <7 40>;             // さ(7) + ENTER → し
            bindings      = <&kp D>;
            layers        = <L_COFFEE>;
        };
        combo_su {
            timeout-ms    = <50>;
            key-positions = <7 20>;             // さ(7) + INT6  → す
            bindings      = <&kp R>;
            layers        = <L_COFFEE>;
        };
        combo_se {
            timeout-ms    = <50>;
            key-positions = <7 41>;             // さ(7) + SPACE → せ
            bindings      = <&kp P>;
            layers        = <L_COFFEE>;
        };
        combo_so {
            timeout-ms    = <50>;
            key-positions = <7 32>;             // さ(7) + 。    → そ
            bindings      = <&kp C>;
            layers        = <L_COFFEE>;
        };

    // ---- た行 (17) ----
        combo_chi {
            timeout-ms    = <50>;
            key-positions = <17 40>;            // た(17) + ENTER → ち
            bindings      = <&kp A>;
            layers        = <L_COFFEE>;
        };
        combo_tsu {
            timeout-ms    = <50>;
            key-positions = <17 20>;            // た(17) + INT6  → つ
            bindings      = <&kp Z>;
            layers        = <L_COFFEE>;
        };
        combo_te {
            timeout-ms    = <50>;
            key-positions = <17 41>;            // た(17) + SPACE → て
            bindings      = <&kp W>;
            layers        = <L_COFFEE>;
        };
        combo_to {
            timeout-ms    = <50>;
            key-positions = <17 32>;            // た(17) + 。    → と
            bindings      = <&kp S>;
            layers        = <L_COFFEE>;
        };

    // ---- な行 (18) ----
        combo_ni {
            timeout-ms    = <50>;
            key-positions = <18 40>;            // な(18) + ENTER → に
            bindings      = <&kp I>;
            layers        = <L_COFFEE>;
        };
        combo_nu {
            timeout-ms    = <50>;
            key-positions = <18 20>;            // な(18) + INT6  → ぬ
            bindings      = <&kp N1>;
            layers        = <L_COFFEE>;
        };
        combo_ne {
            timeout-ms    = <50>;
            key-positions = <18 41>;            // な(18) + SPACE → ね
            bindings      = <&kp COMMA>;
            layers        = <L_COFFEE>;
        };
        combo_no {
            timeout-ms    = <50>;
            key-positions = <18 32>;            // な(18) + 。    → の
            bindings      = <&kp K>;
            layers        = <L_COFFEE>;
        };

    // ---- は行 (19) ----
        combo_hi {
            timeout-ms    = <50>;
            key-positions = <19 40>;            // は(19) + ENTER → ひ
            bindings      = <&kp V>;
            layers        = <L_COFFEE>;
        };
        combo_fu {
            timeout-ms    = <50>;
            key-positions = <19 20>;            // は(19) + INT6  → ふ
            bindings      = <&kp N2>;
            layers        = <L_COFFEE>;
        };
        combo_he {
            timeout-ms    = <50>;
            key-positions = <19 41>;            // は(19) + SPACE → へ
            bindings      = <&kp EQUAL>;
            layers        = <L_COFFEE>;
        };
        combo_ho {
            timeout-ms    = <50>;
            key-positions = <19 32>;            // は(19) + 。    → ほ
            bindings      = <&kp MINUS>;
            layers        = <L_COFFEE>;
        };

    // ---- ま行 (29) ----
        combo_mi {
            timeout-ms    = <50>;
            key-positions = <29 40>;            // ま(29) + ENTER → み
            bindings      = <&kp N>;
            layers        = <L_COFFEE>;
        };
        combo_mu {
            timeout-ms    = <50>;
            key-positions = <29 20>;            // ま(29) + INT6  → む
            bindings      = <&kp NON_US_HASH>;
            layers        = <L_COFFEE>;
        };
        combo_me {
            timeout-ms    = <50>;
            key-positions = <29 41>;            // ま(29) + SPACE → め
            bindings      = <&kp SLASH>;
            layers        = <L_COFFEE>;
        };
        combo_mo {
            timeout-ms    = <50>;
            key-positions = <29 32>;            // ま(29) + 。    → も
            bindings      = <&kp M>;
            layers        = <L_COFFEE>;
        };

    // ---- や行 (30) ----
        combo_yu {
            timeout-ms    = <50>;
            key-positions = <30 20>;            // や(30) + INT6  → ゆ
            bindings      = <&kp N8>;
            layers        = <L_COFFEE>;
        };
        combo_yo {
            timeout-ms    = <50>;
            key-positions = <30 32>;            // や(30) + 。    → よ
            bindings      = <&kp N9>;
            layers        = <L_COFFEE>;
        };

    // ---- ら行 (31) ----
        combo_ri {
            timeout-ms    = <50>;
            key-positions = <31 40>;            // ら(31) + ENTER → り
            bindings      = <&kp L>;
            layers        = <L_COFFEE>;
        };
        combo_ru {
            timeout-ms    = <50>;
            key-positions = <31 20>;            // ら(31) + INT6  → る
            bindings      = <&kp PERIOD>;
            layers        = <L_COFFEE>;
        };
        combo_re {
            timeout-ms    = <50>;
            key-positions = <31 41>;            // ら(31) + SPACE → れ
            bindings      = <&kp SEMICOLON>;
            layers        = <L_COFFEE>;
        };
        combo_ro {
            timeout-ms    = <50>;
            key-positions = <31 32>;            // ら(31) + 。    → ろ
            bindings      = <&kp INT1>;
            layers        = <L_COFFEE>;
        };

    // ---- わ行：N0 ----
        combo_wa {
            timeout-ms    = <50>;
            key-positions = <16 40>;            // ん + ENTER
            bindings      = <&kp N0>;           // わ
            layers        = <L_COFFEE>;
        };
        combo_wo {
            timeout-ms    = <50>;
            key-positions = <16 41>;            // ん + SPACE
            bindings      = <&kp LS(N0)>;       // を
            layers        = <L_COFFEE>;
        };

    // ---- 濁点・半濁点：LSHFT (8) ----
        combo_dakuten {
            timeout-ms    = <50>;
            key-positions = <8 40>;             // LSHFT(8) + ENTER → ゛
            bindings      = <&kp LEFT_BRACKET>;
            layers        = <L_COFFEE>;
        };
        combo_handakuten {
            timeout-ms    = <50>;
            key-positions = <8 41>;             // LSHFT(8) + SPACE → ゜
            bindings      = <&kp RIGHT_BRACKET>;
            layers        = <L_COFFEE>;
        };

    // ---- 「」：INT6 (20) ---- 
        combo_kagi_open {
            timeout-ms    = <50>;
            key-positions = <20 40>;          // INT6 + ENTER
            bindings      = <&kp LS(RBKT)>;   // 「
            layers        = <L_COFFEE>;
        };
        combo_kagi_close {
            timeout-ms    = <50>;
            key-positions = <20 41>;        // INT6 + SPACE
            bindings      = <&kp LS(NUHS)>; // 」
            layers        = <L_COFFEE>;
        };

        // ---- （）：LS(DOT) (32) ...🟥🟥🟥 保留中 🟥🟥🟥

    // BackSpace･Delete：や = N7 (30)
        combo_bspc {
            timeout-ms    = <50>;
            key-positions = <30 40>;        // や + ENTER
            bindings      = <&kp BSPC>;     // BackSpace
            layers        = <L_COFFEE>;
        };
        combo_del {
            timeout-ms    = <50>;
            key-positions = <30 41>;        // や + SPACE
            bindings      = <&kp DEL>;      // Delete
            layers        = <L_COFFEE>;
        };

    // ---- ！･？ = Y (16) ----
        combo_exclam {
            timeout-ms    = <50>;
            key-positions = <16 20>;            // ん + 、
            bindings      = <&kp LS(N1)>;       // ！
            layers        = <L_COFFEE>;
        };
        combo_question {
            timeout-ms    = <50>;
            key-positions = <16 32>;            // ん + 。
            bindings      = <&kp LS(FSLH)>;     // ？ 🟥🟥🟥 (要確認)...現状｢・」が出力 🟥🟥🟥
            layers        = <L_COFFEE>;
        };

    // ---- ←･→･↑･↓ = LC(A) (28) ----
        combo_cursor_left {
            timeout-ms    = <50>;
            key-positions = <28 40>;            // LC(A) + ENTER → ← (長押し: Home)
            bindings      = <&mt HOME LEFT>;
            layers        = <L_COFFEE>;
        };
        combo_cursor_right {
            timeout-ms    = <50>;
            key-positions = <28 41>;            // LC(A) + SPACE → → (長押し: End)
            bindings      = <&mt END RIGHT>;
            layers        = <L_COFFEE>;
        };
        combo_cursor_up {
            timeout-ms    = <50>;
            key-positions = <28 20>;            // LC(A) + INT6  → ↑
            bindings      = <&kp UP>;
            layers        = <L_COFFEE>;
        };
        combo_cursor_down {
            timeout-ms    = <50>;
            key-positions = <28 32>;            // LC(A) + 。    → ↓
            bindings      = <&kp DOWN>;
            layers        = <L_COFFEE>;
        };

    // ---- CTRL+X,C,V,Z : RALT (42) ----       // 🟥🟥🟥 動作チェック 🟥🟥🟥
        combo_copy {
            timeout-ms    = <50>;
            key-positions = <42 40>;            // RALT + ENTER → Ctrl+C (長押し: Ctrl+X)
            bindings      = <&mt RC(X) RC(C)>;
            layers        = <L_COFFEE>;
        };
        combo_paste {
            timeout-ms    = <50>;
            key-positions = <42 41>;            // RALT + SPACE → Ctrl+V (長押し: Ctrl+Z)
            bindings      = <&mt RC(Z) RC(V)>;
            layers        = <L_COFFEE>;
        };

    };



    macros {
    // Macroエリア
    };



    behaviors {

        ROTATE: ROTATE {
            compatible = "zmk,behavior-sensor-rotate-var";
            label = "ROTATE";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;

            tap-ms = <20>;
        };

    };



    keymap {
        compatible = "zmk,keymap";

        QWERTY_DEFAULT {
            bindings = <
&kp Q             &kp W         &kp E         &kp R                  &kp T                                                                       &kp Y            &kp U  &kp I      &kp O                  &kp P
&kp A             &kp S         &kp D         &kp F                  &kp G                         &mkp RCLK                     &kp UP_ARROW    &kp H            &kp J  &kp K      &lt L_MOUSE_DEFAULT L  &lt L_SCROLL_DEFAULT MINUS
&mt LEFT_SHIFT Z  &kp X         &kp C         &kp V                  &kp B                         &mkp LCLK                     &kp DOWN_ARROW  &kp N            &kp M  &kp COMMA  &kp DOT                &mt LEFT_SHIFT SLASH
&kp LCTRL         &kp LEFT_WIN  &kp LEFT_ALT  &lt L_BT_SETTING INT4  &lt L_FUNCTION_DEFAULT SPACE  &lt L_ARROW_DEFAULT INT5      &kp BACKSPACE   &lt L_NUM_DEFAULT ENTER                                   &kp DEL
            >;

            sensor-bindings = <&ROTATE SCRL_DOWN SCRL_UP>;
        };

        NUM_DEFAULT {
            bindings = <
&kp MINUS                   &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp PLUS                                     &kp CARET         &kp AMPERSAND      &kp TILDE       &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS
&kp SLASH                   &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp ASTERISK  &trans         &kp UNDERSCORE  &kp EXCLAMATION   &kp AT_SIGN        &kp HASH        &kp DOLLAR            &kp PERCENT
&mt LEFT_SHIFT KP_NUMBER_0  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp PERIOD    &kp EQUAL      &trans          &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp LEFT_BRACE  &kp RIGHT_BRACE       &kp BACKSLASH
&trans                      &trans           &trans           &trans           &trans        &trans         &trans          &trans                                                                     &kp PIPE
            >;
        };

        ARROW_DEFAULT {
            bindings = <
&kp ESCAPE      &kp LC(LS(TAB))         &kp UP_ARROW    &kp LC(TAB)              &trans                       &trans  &trans  &trans  &trans  &trans
&kp HOME        &kp LEFT_ARROW          &kp DOWN_ARROW  &kp RIGHT_ARROW          &kp END  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&kp LEFT_SHIFT  &kp LG(LS(LEFT_ARROW))  &trans          &kp LG(LS(RIGHT_ARROW))  &trans   &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans          &trans                  &trans          &trans                   &trans   &trans      &trans  &trans                          &trans
            >;

            sensor-bindings = <&inc_dec_kp LC(PAGE_UP) LC(PAGE_DOWN)>;
        };

        MOUSE_DEFAULT {
            bindings = <
&trans                      &trans                     &kp LC(PAGE_UP)  &kp LC(PAGE_DOWN)  &kp LC(W)                         &kp LC(W)  &kp LC(PAGE_UP)  &kp LC(PAGE_DOWN)  &trans                     &trans
&lt L_SCROLL_DEFAULT SPACE  &lt L_MOUSE_DEFAULT SPACE  &mkp LCLK        &mkp RCLK          &mkp MCLK  &mkp RCLK      &trans  &mkp MCLK  &mkp LCLK        &mkp RCLK          &lt L_MOUSE_DEFAULT SPACE  &lt L_SCROLL_DEFAULT SPACE
&trans                      &trans                     &trans           &trans             &trans     &mkp LCLK      &trans  &trans     &mkp MB4         &mkp MB5           &trans                     &trans
&trans                      &trans                     &trans           &trans             &trans     &trans         &trans  &trans                                                                    &trans
            >;
        };

        SCROLL_DEFAULT {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&none   &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };

        FUNCTION_DEFAULT {
            bindings = <
&kp F1   &kp F2  &kp F3  &kp F4  &kp F5                        &kp F1  &kp F2  &kp F3  &kp F4  &kp F5
&kp F6   &kp F7  &kp F8  &kp F9  &kp F10  &trans      &kp F13  &kp F6  &kp F7  &kp F8  &kp F9  &kp F10
&kp F11  &trans  &trans  &trans  &trans   &trans      &trans   &trans  &trans  &trans  &trans  &kp F11
&kp F12  &trans  &trans  &trans  &trans   &trans      &trans   &trans                          &kp F12
            >;
        };

        BT_SETTING {
            bindings = <
&to L_COFFEE         &trans        &trans        &trans        &trans                                 &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans               &trans        &trans        &trans        &trans     &trans      &studio_unlock  &trans        &trans        &trans        &trans        &trans
&trans               &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kt KP_N4  &trans      &bootloader     &trans        &trans        &trans        &trans        &bt BT_CLR
&trans               &trans        &trans        &trans        &trans     &trans      &trans          &trans                                                  &bt BT_CLR_ALL
            >;
        };

// -------------------------------------------------------------
// 🟩🟩🟩 珈琲配列 🟩🟩🟩
// -------------------------------------------------------------

        COFFEE {
            bindings = <
&to L_QWERTY_DEFAULT  &trans  &trans  &trans  &trans                               &kp N3     &kp T   &kp X  &kp LSHFT    &kp INT3
&trans                &trans  &trans  &trans  &trans  &trans      &kp Y            &kp Q      &kp U   &kp F  &kp INT6     &sk RCTRL
&trans                &trans  &trans  &trans  &trans  &trans      &mt LG(V) LC(A)  &kp J      &kp N7  &kp O  &kp LS(DOT)  &sk RSHFT
&trans                &trans  &trans  &trans  &trans  &trans      &kp ENTER        &kp SPACE                              &sk RALT
            >;
        };

        QWERTY_RIGHT {
            bindings = <
&trans  &trans  &trans  &trans  &trans                         &kp U      &kp I      &kp O       &kp P          &kp Y
&trans  &trans  &trans  &trans  &trans  &trans      &kp H      &kp J      &kp K      &kp L       &kp BACKSPACE  &kp RCTRL
&none   &trans  &trans  &trans  &trans  &trans      &kp N      &kp M      &kp COMMA  &kp PERIOD  &none          &kp RSHFT
&trans  &trans  &trans  &trans  &trans  &trans      &kp ENTER  &kp SPACE                                        &none
            >;
        };

        QWERTY_LEFT {
            bindings = <
&trans  &trans  &trans  &trans  &trans                         &kp R      &kp E  &kp W  &kp Q  &kp T
&trans  &trans  &trans  &trans  &trans              &kp G      &kp F      &kp D  &kp S  &kp A  &kp LCTRL
&none   &trans  &trans  &trans  &trans  &trans      &kp B      &kp V      &kp C  &kp X  &kp Z  &kp LSHFT
&trans  &trans  &trans  &trans  &trans  &trans      &kp ENTER  &kp SPACE                       &none
            >;
        };

        NUMBER {
            bindings = <
&trans  &trans  &trans  &trans  &trans                                          &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp MINUS   &none                            
&trans  &trans  &trans  &trans  &trans  &trans      &kp SLASH                   &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp PLUS    &kp ASTERISK
&trans  &trans  &trans  &trans  &trans  &trans      &mt LEFT_SHIFT KP_NUMBER_0  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp PERIOD  &kp EQUAL
&trans  &trans  &trans  &trans  &trans  &trans      &kp ENTER                   &kp SPACE                                                      &none
            >;
        };

        SIMBOL {
            bindings = <
&trans  &trans  &trans  &trans  &trans                              &kp CARET         &kp AMPERSAND      &kp TILDE       &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS
&trans  &trans  &trans  &trans  &trans  &trans      &kp UNDERSCORE  &kp EXCLAMATION   &kp AT_SIGN        &kp HASH        &kp DOLLAR            &kp PERCENT
&trans  &trans  &trans  &trans  &trans  &trans      &none           &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp LEFT_BRACE  &kp RIGHT_BRACE       &kp BACKSLASH
&trans  &trans  &trans  &trans  &trans  &trans      &kp ENTER       &kp SPACE                                                                  &kp PIPE
            >;
        };

        ARROW {
            bindings = <
&trans  &trans  &trans  &trans  &trans                              &kp LC(LS(TAB))         &kp UP_ARROW     &kp LC(TAB)              &kp ESCAPE   &trans
&trans  &trans  &trans  &trans  &trans  &trans      &kp HOME        &kp LEFT_ARROW          &kp DOWN_ARROW   &kp RIGHT_ARROW          &kp END      &trans
&trans  &trans  &trans  &trans  &trans  &trans      &kp LEFT_SHIFT  &kp LG(LS(LEFT_ARROW))  &trans           &kp LG(LS(RIGHT_ARROW))  &trans       &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans          &trans                  &trans           &trans                   &trans       &trans
            >;
        };

        FUNCTION {     // 🟥🟥🟥 未配置 🟥🟥🟥
            bindings = <
&kp F1   &kp F2  &kp F3  &kp F4  &kp F5                        &kp F1  &kp F2  &kp F3  &kp F4  &kp F5
&kp F6   &kp F7  &kp F8  &kp F9  &kp F10  &trans      &kp F13  &kp F6  &kp F7  &kp F8  &kp F9  &kp F10
&kp F11  &trans  &trans  &trans  &trans   &trans      &trans   &trans  &trans  &trans  &trans  &kp F11
&kp F12  &trans  &trans  &trans  &trans   &trans      &trans   &trans                          &kp F12
            >;
        };

        TRACKBALL {    // 🟥🟥🟥 未配置 🟥🟥🟥
            bindings = <
&trans                      &trans                     &kp LC(PAGE_UP)  &kp LC(PAGE_DOWN)  &kp LC(W)                         &kp LC(W)  &kp LC(PAGE_UP)  &kp LC(PAGE_DOWN)  &trans                     &trans
&lt L_SCROLL_DEFAULT SPACE  &lt L_MOUSE_DEFAULT SPACE  &mkp LCLK        &mkp RCLK          &mkp MCLK  &mkp RCLK      &trans  &mkp MCLK  &mkp LCLK        &mkp RCLK          &lt L_MOUSE_DEFAULT SPACE  &lt L_SCROLL_DEFAULT SPACE
&trans                      &trans                     &trans           &trans             &trans     &mkp LCLK      &trans  &trans     &mkp MB4         &mkp MB5           &trans                     &trans
&trans                      &trans                     &trans           &trans             &trans     &trans         &trans  &trans                                                                    &trans
            >;
        };

        SCROLL {       // 🟥🟥🟥 未配置 🟥🟥🟥
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&none   &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };

        MOUSE {
            bindings = <
&trans  &trans  &trans  &trans  &trans                                &trans          &mmv MOVE_UP    &trans           &trans            &msc SCRL_UP
&trans  &trans  &trans  &trans  &trans  &trans      &mo L_MOUSE_SLOW  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &trans            &msc SCRL_DOWN
&none   &trans  &trans  &trans  &trans  &trans      &mo L_MOUSE_FAST  &mkp MB4        &mkp MB5        &trans           &msc SCRL_LEFT    &msc SCRL_RIGHT
&trans  &trans  &trans  &trans  &trans  &trans      &mkp RCLK         &mkp LCLK                                                          &mkp MCLK
            >;
        };

        MOUSE_SLOW {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans          &mmv SLOW_UP    &trans           &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &mmv SLOW_LEFT  &mmv SLOW_DOWN  &mmv SLOW_RIGHT  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans          &trans          &trans           &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                                           &trans
            >;
        };

        MOUSE_FAST {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans          &mmv FAST_UP    &trans           &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &mmv FAST_LEFT  &mmv FAST_DOWN  &mmv FAST_RIGHT  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans          &trans          &trans           &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                                                   &trans
            >;
        };

    };
};
