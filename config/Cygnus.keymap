#define ZMK_POINTING_DEFAULT_SCRL_VAL 120    // default: 10

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

// 珈琲配列
#define L_COFFEE                  0
#define L_QWERTY_RIGHT            1
#define L_QWERTY_LEFT             2
#define L_NUMBER                  3
#define L_SIMBOL                  4
#define L_FUNCTION                5
#define L_TRACKBALL               6
#define L_SCROLL                  7
#define L_BT_SETTING              8

// マウスレイヤー
#define L_MOUSE                   9
#define L_MOUSE_SLOW             10
#define L_MOUSE_FAST             11

// 矢印レイヤー (不要なら削除)
#define L_ARROW                  12

// カーソル速度（標準は MOVE_UP 等の 600）
#define SLOW_UP     MOVE_Y(-200)
#define SLOW_DOWN   MOVE_Y(200)
#define SLOW_LEFT   MOVE_X(-200)
#define SLOW_RIGHT  MOVE_X(200)

#define FAST_UP     MOVE_Y(-1800)
#define FAST_DOWN   MOVE_Y(1800)
#define FAST_LEFT   MOVE_X(-1800)
#define FAST_RIGHT  MOVE_X(1800)

// 拗音の小書き文字（JISかな: Shift+7/8/9）
#define SM_YA  RS(N7)                 // ゃ
#define SM_YU  RS(N8)                 // ゅ
#define SM_YO  RS(N9)                 // ょ



&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

/ {



    combos {
        compatible = "zmk,combos";

    // ---- 50音 ----
    // ---- あ行 (5) ----
        combo_i {
            timeout-ms    = <50>;
            key-positions = <5 40>;             // 5 + 40 → い
            bindings      = <&kp E>;
            layers        = <L_COFFEE>;
        };
        combo_u {
            timeout-ms    = <50>;
            key-positions = <5 20>;             // 5 + 20 → う
            bindings      = <&kp N4>;
            layers        = <L_COFFEE>;
        };
        combo_e {
            timeout-ms    = <50>;
            key-positions = <5 41>;             // 5 + 41 → え
            bindings      = <&kp N5>;
            layers        = <L_COFFEE>;
        };
        combo_o {
            timeout-ms    = <50>;
            key-positions = <5 32>;             // 5 + 32 → お
            bindings      = <&kp N6>;
            layers        = <L_COFFEE>;
        };

    // ---- か行 (6) ----
        combo_ki {
            timeout-ms    = <50>;
            key-positions = <6 40>;             // 6 + 40 → き
            bindings      = <&kp G>;
            layers        = <L_COFFEE>;
        };
        combo_ku {
            timeout-ms    = <50>;
            key-positions = <6 20>;             // 6 + 20 → く / 右Shift待機: きゅ
            bindings      = <&mm_kyu>;
            layers        = <L_COFFEE>;
        };
        combo_ke {
            timeout-ms    = <50>;
            key-positions = <6 41>;             // 6 + 41 → け
            bindings      = <&kp SQT>;
            layers        = <L_COFFEE>;
        };
        combo_ko {
            timeout-ms    = <50>;
            key-positions = <6 32>;             // 6 + 32 → こ / 右Shift待機: きょ
            bindings      = <&mm_kyo>;
            layers        = <L_COFFEE>;
        };

    // ---- さ行 (7) ----
        combo_shi {
            timeout-ms    = <50>;
            key-positions = <7 40>;             // 7 + 40 → し
            bindings      = <&kp D>;
            layers        = <L_COFFEE>;
        };
        combo_su {
            timeout-ms    = <50>;
            key-positions = <7 20>;             // 7 + 20 → す / 右Shift待機: しゅ
            bindings      = <&mm_syu>;
            layers        = <L_COFFEE>;
        };
        combo_se {
            timeout-ms    = <50>;
            key-positions = <7 41>;             // 7 + 41 → せ
            bindings      = <&kp P>;
            layers        = <L_COFFEE>;
        };
        combo_so {
            timeout-ms    = <50>;
            key-positions = <7 32>;             // 7 + 32 → そ / 右Shift待機: しょ
            bindings      = <&mm_syo>;
            layers        = <L_COFFEE>;
        };

    // ---- た行 (17) ----
        combo_chi {
            timeout-ms    = <50>;
            key-positions = <17 40>;            // 17 + 40 → ち
            bindings      = <&kp A>;
            layers        = <L_COFFEE>;
        };
        combo_tsu {
            timeout-ms    = <50>;
            key-positions = <17 20>;            // 17 + 20 → つ / 右Shift待機: ちゅ
            bindings      = <&mm_tyu>;
            layers        = <L_COFFEE>;
        };
        combo_te {
            timeout-ms    = <50>;
            key-positions = <17 41>;            // 17 + 41 → て
            bindings      = <&kp W>;
            layers        = <L_COFFEE>;
        };
        combo_to {
            timeout-ms    = <50>;
            key-positions = <17 32>;            // 17 + 32 → と / 右Shift待機: ちょ
            bindings      = <&mm_tyo>;
            layers        = <L_COFFEE>;
        };

    // ---- な行 (18) ----
        combo_ni {
            timeout-ms    = <50>;
            key-positions = <18 40>;            // 18 + 40 → に
            bindings      = <&kp I>;
            layers        = <L_COFFEE>;
        };
        combo_nu {
            timeout-ms    = <50>;
            key-positions = <18 20>;            // 18 + 20 → ぬ / 右Shift待機: にゅ
            bindings      = <&mm_nyu>;
            layers        = <L_COFFEE>;
        };
        combo_ne {
            timeout-ms    = <50>;
            key-positions = <18 41>;            // 18 + 41 → ね
            bindings      = <&kp COMMA>;
            layers        = <L_COFFEE>;
        };
        combo_no {
            timeout-ms    = <50>;
            key-positions = <18 32>;            // 18 + 32 → の / 右Shift待機: にょ
            bindings      = <&mm_nyo>;
            layers        = <L_COFFEE>;
        };

    // ---- は行 (19) ----
        combo_hi {
            timeout-ms    = <50>;
            key-positions = <19 40>;            // 19 + 40 → ひ
            bindings      = <&kp V>;
            layers        = <L_COFFEE>;
        };
        combo_fu {
            timeout-ms    = <50>;
            key-positions = <19 20>;            // 19 + 20 → ふ / 右Shift待機: ひゅ
            bindings      = <&mm_hyu>;
            layers        = <L_COFFEE>;
        };
        combo_he {
            timeout-ms    = <50>;
            key-positions = <19 41>;            // 19 + 41 → へ
            bindings      = <&kp EQUAL>;
            layers        = <L_COFFEE>;
        };
        combo_ho {
            timeout-ms    = <50>;
            key-positions = <19 32>;            // 19 + 32 → ほ / 右Shift待機: ひょ
            bindings      = <&mm_hyo>;
            layers        = <L_COFFEE>;
        };

    // ---- ま行 (29) ----
        combo_mi {
            timeout-ms    = <50>;
            key-positions = <29 40>;            // 29 + 40 → み
            bindings      = <&kp N>;
            layers        = <L_COFFEE>;
        };
        combo_mu {
            timeout-ms    = <50>;
            key-positions = <29 20>;            // 29 + 20 → む / 右Shift待機: みゅ
            bindings      = <&mm_myu>;
            layers        = <L_COFFEE>;
        };
        combo_me {
            timeout-ms    = <50>;
            key-positions = <29 41>;            // 29 + 41 → め
            bindings      = <&kp SLASH>;
            layers        = <L_COFFEE>;
        };
        combo_mo {
            timeout-ms    = <50>;
            key-positions = <29 32>;            // 29 + 32 → も / 右Shift待機: みょ
            bindings      = <&mm_myo>;
            layers        = <L_COFFEE>;
        };

    // ---- や行 (30) ----
        combo_yu {
            timeout-ms    = <50>;
            key-positions = <30 20>;            // 30 + 20 → ゆ
            bindings      = <&kp N8>;
            layers        = <L_COFFEE>;
        };
        combo_yo {
            timeout-ms    = <50>;
            key-positions = <30 32>;            // 30 + 32 → よ
            bindings      = <&kp N9>;
            layers        = <L_COFFEE>;
        };

    // ---- ら行 (31) ----
        combo_ri {
            timeout-ms    = <50>;
            key-positions = <31 40>;            // 31 + 40 → り
            bindings      = <&kp L>;
            layers        = <L_COFFEE>;
        };
        combo_ru {
            timeout-ms    = <50>;
            key-positions = <31 20>;            // 31 + 20 → る / 右Shift待機: りゅ
            bindings      = <&mm_ryu>;
            layers        = <L_COFFEE>;
        };
        combo_re {
            timeout-ms    = <50>;
            key-positions = <31 41>;            // 31 + 41 → れ
            bindings      = <&kp SEMICOLON>;
            layers        = <L_COFFEE>;
        };
        combo_ro {
            timeout-ms    = <50>;
            key-positions = <31 32>;            // 31 + 32 → ろ / 右Shift待機: りょ
            bindings      = <&mm_ryo>;
            layers        = <L_COFFEE>;
        };

    // ---- わ行：N0 ----
        combo_wa {
            timeout-ms    = <50>;
            key-positions = <16 40>;            // 16 + 40 → わ
            bindings      = <&kp N0>;
            layers        = <L_COFFEE>;
        };
        combo_wo {
            timeout-ms    = <50>;
            key-positions = <16 41>;            // 16 + 41 → を
            bindings      = <&kp RS(N0)>;
            layers        = <L_COFFEE>;
        };

    // ---- 濁点系：BACKSPACE (28) + 清音キー [+ 母音キー] ----
    // 母音キー: 40=い段(⏎) / 20=う段(、) / 41=え段(␣) / 32=お段(。)

    // ---- が行 (6) ----
        combo_ga {
            timeout-ms    = <50>;
            key-positions = <28 6>;             // 28 + 6 → が / 右Shift待機: ぎゃ
            bindings      = <&mm_gya>;
            layers        = <L_COFFEE>;
        };
        combo_gi {
            timeout-ms    = <50>;
            key-positions = <28 6 40>;          // 28 + 6 + 40 → ぎ
            bindings      = <&dkt G>;
            layers        = <L_COFFEE>;
        };
        combo_gu {
            timeout-ms    = <50>;
            key-positions = <28 6 20>;          // 28 + 6 + 20 → ぐ / 右Shift待機: ぎゅ
            bindings      = <&mm_gyu>;
            layers        = <L_COFFEE>;
        };
        combo_ge {
            timeout-ms    = <50>;
            key-positions = <28 6 41>;          // 28 + 6 + 41 → げ
            bindings      = <&dkt SQT>;
            layers        = <L_COFFEE>;
        };
        combo_go {
            timeout-ms    = <50>;
            key-positions = <28 6 32>;          // 28 + 6 + 32 → ご / 右Shift待機: ぎょ
            bindings      = <&mm_gyo>;
            layers        = <L_COFFEE>;
        };

    // ---- ざ行 (7) ----
        combo_za {
            timeout-ms    = <50>;
            key-positions = <28 7>;             // 28 + 7 → ざ / 右Shift待機: じゃ
            bindings      = <&mm_zya>;
            layers        = <L_COFFEE>;
        };
        combo_ji {
            timeout-ms    = <50>;
            key-positions = <28 7 40>;          // 28 + 7 + 40 → じ
            bindings      = <&dkt D>;
            layers        = <L_COFFEE>;
        };
        combo_zu {
            timeout-ms    = <50>;
            key-positions = <28 7 20>;          // 28 + 7 + 20 → ず / 右Shift待機: じゅ
            bindings      = <&mm_zyu>;
            layers        = <L_COFFEE>;
        };
        combo_ze {
            timeout-ms    = <50>;
            key-positions = <28 7 41>;          // 28 + 7 + 41 → ぜ
            bindings      = <&dkt P>;
            layers        = <L_COFFEE>;
        };
        combo_zo {
            timeout-ms    = <50>;
            key-positions = <28 7 32>;          // 28 + 7 + 32 → ぞ / 右Shift待機: じょ
            bindings      = <&mm_zyo>;
            layers        = <L_COFFEE>;
        };

    // ---- だ行 (17) ----
        combo_da {
            timeout-ms    = <50>;
            key-positions = <28 17>;            // 28 + 17 → だ / 右Shift待機: ぢゃ
            bindings      = <&mm_dya>;
            layers        = <L_COFFEE>;
        };
        combo_di {
            timeout-ms    = <50>;
            key-positions = <28 17 40>;         // 28 + 17 + 40 → ぢ
            bindings      = <&dkt A>;
            layers        = <L_COFFEE>;
        };
        combo_du {
            timeout-ms    = <50>;
            key-positions = <28 17 20>;         // 28 + 17 + 20 → づ / 右Shift待機: ぢゅ
            bindings      = <&mm_dyu>;
            layers        = <L_COFFEE>;
        };
        combo_de {
            timeout-ms    = <50>;
            key-positions = <28 17 41>;         // 28 + 17 + 41 → で
            bindings      = <&dkt W>;
            layers        = <L_COFFEE>;
        };
        combo_do {
            timeout-ms    = <50>;
            key-positions = <28 17 32>;         // 28 + 17 + 32 → ど / 右Shift待機: ぢょ
            bindings      = <&mm_dyo>;
            layers        = <L_COFFEE>;
        };

    // ---- ば行・ぱ行 (19) ※右Ctrl(sticky)を先に押すとぱ行 ----
        combo_ba {
            timeout-ms    = <50>;
            key-positions = <28 19>;            // 28 + 19 → ば / 右Ctrl待機: ぱ
            bindings      = <&mm_ba>;
            layers        = <L_COFFEE>;
        };
        combo_bi {
            timeout-ms    = <50>;
            key-positions = <28 19 40>;         // 28 + 19 + 40 → び / 右Ctrl待機: ぴ
            bindings      = <&mm_bi>;
            layers        = <L_COFFEE>;
        };
        combo_bu {
            timeout-ms    = <50>;
            key-positions = <28 19 20>;         // 28 + 19 + 20 → ぶ / 右Ctrl待機: ぷ
            bindings      = <&mm_bu>;
            layers        = <L_COFFEE>;
        };
        combo_be {
            timeout-ms    = <50>;
            key-positions = <28 19 41>;         // 28 + 19 + 41 → べ / 右Ctrl待機: ぺ
            bindings      = <&mm_be>;
            layers        = <L_COFFEE>;
        };
        combo_bo {
            timeout-ms    = <50>;
            key-positions = <28 19 32>;         // 28 + 19 + 32 → ぼ / 右Ctrl待機: ぽ
            bindings      = <&mm_bo>;
            layers        = <L_COFFEE>;
        };

    // ---- 濁点・半濁点：LSHFT (8) ----
        combo_dakuten {
            timeout-ms    = <50>;
            key-positions = <8 40>;             // 8 + 40 → ゛
            bindings      = <&kp LEFT_BRACKET>;
            layers        = <L_COFFEE>;
        };
        combo_handakuten {
            timeout-ms    = <50>;
            key-positions = <8 41>;             // 8 + 41 → ゜
            bindings      = <&kp RIGHT_BRACKET>;
            layers        = <L_COFFEE>;
        };

    // ---- 「 」：INT6 (20) ----
        combo_kagi_open {
            timeout-ms    = <50>;
            key-positions = <20 40>;            // 20 + 40 → 「
            bindings      = <&kp RS(RBKT)>;
            layers        = <L_COFFEE>;
        };
        combo_kagi_close {
            timeout-ms    = <50>;
            key-positions = <20 41>;            // 20 + 41 → 」
            bindings      = <&kp RS(NUHS)>;
            layers        = <L_COFFEE>;
        };

    // ---- （ ）：RS(DOT) (32)   🟥🟥🟥 保留中...マクロが必要な模様 🟥🟥🟥

    // ---- ！･？ = Y (16) ----
        combo_exclam {
            timeout-ms    = <50>;
            key-positions = <16 20>;            // 16 + 20 → ！
            bindings      = <&kp RS(N1)>;
            layers        = <L_COFFEE>;
        };
        combo_question {
            timeout-ms    = <50>;
            key-positions = <16 32>;            // 16 + 32 → ？   🟥🟥🟥 要確認...現状｢・」が出力 🟥🟥🟥
            bindings      = <&kp RS(FSLH)>;
            layers        = <L_COFFEE>;
        };

    // ---- ←･→･↑･↓ = BACKSPACE (28) ----
    // 右Ctrl/右Shift/右Alt(sticky)を先に押すと、behaviors側(A)のmm_*でコマンド系に切替
        combo_cursor_left {
            timeout-ms    = <50>;
            key-positions = <28 40>;            // 28 + 40 → ← (長押し: Home) / 右Ctrl待機: Ctrl+C ほか
            bindings      = <&mm_cursor_left>;
            layers        = <L_COFFEE>;
        };
        combo_cursor_right {
            timeout-ms    = <50>;
            key-positions = <28 41>;            // 28 + 41 → → (長押し: End) / 右Ctrl待機: Ctrl+V ほか
            bindings      = <&mm_cursor_right>;
            layers        = <L_COFFEE>;
        };
        combo_cursor_up {
            timeout-ms    = <50>;
            key-positions = <28 20>;            // 28 + 20 → ↑ (長押し: Ctrl+Z) / 右Ctrl待機: Ctrl+X ほか
            bindings      = <&mm_cursor_up>;
            layers        = <L_COFFEE>;
        };
        combo_cursor_down {
            timeout-ms    = <50>;
            key-positions = <28 32>;            // 28 + 32 → ↓ (長押し: Ctrl+A) / 右Ctrl待機: Win+V ほか
            bindings      = <&mm_cursor_down>;
            layers        = <L_COFFEE>;
        };

    };



    macros {
    // 濁点: 渡したキー + ゛(LEFT_BRACKET)
        dkt: dkt {
            compatible = "zmk,behavior-macro-one-param";
            label = "DKT";
            #binding-cells = <1>;
            wait-ms = <10>;
            tap-ms  = <10>;
            bindings = <&macro_param_1to1>, <&macro_tap &kp MACRO_PLACEHOLDER &kp LEFT_BRACKET>;
        };

    // 半濁点: 渡したキー + ゜(RIGHT_BRACKET)
        hdk: hdk {
            compatible = "zmk,behavior-macro-one-param";
            label = "HDK";
            #binding-cells = <1>;
            wait-ms = <10>;
            tap-ms  = <10>;
            bindings = <&macro_param_1to1>, <&macro_tap &kp MACRO_PLACEHOLDER &kp RIGHT_BRACKET>;
        };

    // 拗音: 渡した2キーを順に打つ（例: &yoon G SM_YA → きゃ）
        yoon: yoon {
            compatible = "zmk,behavior-macro-two-param";
            label = "YOON";
            #binding-cells = <2>;
            wait-ms = <10>;
            tap-ms  = <10>;
            bindings = <&macro_param_1to1>, <&macro_tap &kp MACRO_PLACEHOLDER>,
                       <&macro_param_2to1>, <&macro_tap &kp MACRO_PLACEHOLDER>;
        };

    // 濁音拗音: 1キー目 + ゛(LEFT_BRACKET) + 2キー目（例: &yoon_dk G SM_YA → ぎゃ）
        yoon_dk: yoon_dk {
            compatible = "zmk,behavior-macro-two-param";
            label = "YOON_DK";
            #binding-cells = <2>;
            wait-ms = <10>;
            tap-ms  = <10>;
            bindings = <&macro_param_1to1>, <&macro_tap &kp MACRO_PLACEHOLDER &kp LEFT_BRACKET>,
                       <&macro_param_2to1>, <&macro_tap &kp MACRO_PLACEHOLDER>;
        };

    // 半濁音拗音: 1キー目 + ゜(RIGHT_BRACKET) + 2キー目（例: &yoon_hd V SM_YA → ぴゃ）
        yoon_hd: yoon_hd {
            compatible = "zmk,behavior-macro-two-param";
            label = "YOON_HD";
            #binding-cells = <2>;
            wait-ms = <10>;
            tap-ms  = <10>;
            bindings = <&macro_param_1to1>, <&macro_tap &kp MACRO_PLACEHOLDER &kp RIGHT_BRACKET>,
                       <&macro_param_2to1>, <&macro_tap &kp MACRO_PLACEHOLDER>;
        };

    };



    behaviors {

        ROTATE: ROTATE {
            compatible = "zmk,behavior-sensor-rotate-var";
            label = "ROTATE";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;

            tap-ms = <20>;
        };

    // タップ=キー、ホールド=別キー（コンボ用。タップ優先＝重なり打ちでホールドに誤判定しない）
        ht_kp: hold_tap_kp {
            compatible = "zmk,behavior-hold-tap";
            label = "HOLD_TAP_KP";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <250>;
            bindings = <&kp>, <&kp>;        // 1番目=ホールド、2番目=タップ
        };

    // タップ=キー、ホールド=レイヤーへ移動（離しても滞在）
        ht_to: hold_tap_to {
            compatible = "zmk,behavior-hold-tap";
            label = "HOLD_TAP_TO";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&to>, <&kp>;        // 1番目=ホールド、2番目=タップ
        };

    // ======================================================================
    // A. combo(28+各キー)用: 右Ctrl/右Shift/右Alt(sticky)待機中にコマンド系へ切替
    //    判定順: 右Ctrl待機 → コピペ系 / 右Shift待機 → ウィンドウ操作系 / 右Alt待機 → Ctrl+F / なし → カーソル系
    //    命名: 外側(comboから呼ぶ入口)=機能名 mm_cursor_* / 内側=判定する修飾キー mm_rs_*(右Shift)・mm_ra_*(右Alt)
    // ======================================================================

    // ---- 外側(入口): 右Ctrl待機中ならコピペ系、それ以外は内側1(右Shift判定)へ ----
        mm_cursor_left: mm_cursor_left {
            compatible = "zmk,behavior-mod-morph";
            label = "MM_CURSOR_LEFT";
            #binding-cells = <0>;
            bindings = <&mm_rs_left>, <&kp C>;              // 40: 右Ctrl待機=Ctrl+C / それ以外は内側へ
            mods = <(MOD_RCTL)>;
            keep-mods = <(MOD_RCTL)>;                       // 右Ctrlを残す
        };

        mm_cursor_right: mm_cursor_right {
            compatible = "zmk,behavior-mod-morph";
            label = "MM_CURSOR_RIGHT";
            #binding-cells = <0>;
            bindings = <&mm_rs_right>, <&kp V>;             // 41: 右Ctrl待機=Ctrl+V / それ以外は内側へ
            mods = <(MOD_RCTL)>;
            keep-mods = <(MOD_RCTL)>;
        };

        mm_cursor_up: mm_cursor_up {
            compatible = "zmk,behavior-mod-morph";
            label = "MM_CURSOR_UP";
            #binding-cells = <0>;
            bindings = <&mm_rs_up>, <&kp X>;                // 20: 右Ctrl待機=Ctrl+X / それ以外は内側へ
            mods = <(MOD_RCTL)>;
            keep-mods = <(MOD_RCTL)>;
        };

        mm_cursor_down: mm_cursor_down {
            compatible = "zmk,behavior-mod-morph";
            label = "MM_CURSOR_DOWN";
            #binding-cells = <0>;
            bindings = <&mm_rs_down>, <&kp RG(V)>;          // 32: 右Ctrl待機=Win+V / それ以外は内側へ
            mods = <(MOD_RCTL)>;                            // keep-modsなし → 右Ctrlを外してWin+Vだけ出す
        };

    // ---- 内側1(RS): 右Shift待機中ならウィンドウ操作系、なければ内側2(右Alt判定)へ ----
        mm_rs_left: mm_rs_left {
            compatible = "zmk,behavior-mod-morph";
            label = "MM_RS_LEFT";
            #binding-cells = <0>;
            bindings = <&mm_ra_left>, <&kp RC(RS(TAB))>;    // 40: 右Shift待機=Ctrl+Shift+Tab / それ以外は内側2へ
            mods = <(MOD_RSFT)>;                            // keep-modsなし → 右Shiftを外して明示指定を出す
        };

        mm_rs_right: mm_rs_right {
            compatible = "zmk,behavior-mod-morph";
            label = "MM_RS_RIGHT";
            #binding-cells = <0>;
            bindings = <&mm_ra_right>, <&kp RC(TAB)>;       // 41: 右Shift待機=Ctrl+Tab / それ以外は内側2へ
            mods = <(MOD_RSFT)>;
        };

        mm_rs_up: mm_rs_up {
            compatible = "zmk,behavior-mod-morph";
            label = "MM_RS_UP";
            #binding-cells = <0>;
            bindings = <&mm_ra_up>, <&kp RG(TAB)>;          // 20: 右Shift待機=Win+Tab / それ以外は内側2へ
            mods = <(MOD_RSFT)>;
        };

        mm_rs_down: mm_rs_down {
            compatible = "zmk,behavior-mod-morph";
            label = "MM_RS_DOWN";
            #binding-cells = <0>;
            bindings = <&mm_ra_down>, <&kp RG(D)>;          // 32: 右Shift待機=Win+D / それ以外は内側2へ
            mods = <(MOD_RSFT)>;
        };

    // ---- 内側2(RA): 右Alt待機中ならCtrl+F、なければカーソル系 ----
        mm_ra_left: mm_ra_left {
            compatible = "zmk,behavior-mod-morph";
            label = "MM_RA_LEFT";
            #binding-cells = <0>;
            bindings = <&mt HOME LEFT>, <&kp RC(F)>;        // 40: ← (長押しHome) / 🟦暫定 Ctrl+F 出力
            mods = <(MOD_RALT)>;                            // keep-modsなし → 右Altを外してCtrl+Fだけ出す
        };

        mm_ra_right: mm_ra_right {
            compatible = "zmk,behavior-mod-morph";
            label = "MM_RA_RIGHT";
            #binding-cells = <0>;
            bindings = <&mt END RIGHT>, <&kp RC(F)>;        // 41: → (長押しEnd) / 🟦暫定 Ctrl+F 出力
            mods = <(MOD_RALT)>;
        };

        mm_ra_up: mm_ra_up {
            compatible = "zmk,behavior-mod-morph";
            label = "MM_RA_UP";
            #binding-cells = <0>;
            bindings = <&mt RC(Z) UP>, <&kp RC(F)>;         // 20: ↑ (長押しCtrl+Z) / 🟦暫定 Ctrl+F 出力
            mods = <(MOD_RALT)>;
        };

        mm_ra_down: mm_ra_down {
            compatible = "zmk,behavior-mod-morph";
            label = "MM_RA_DOWN";
            #binding-cells = <0>;
            bindings = <&mt RC(A) DOWN>, <&kp RC(F)>;       // 32: ↓ (長押しCtrl+A) / 🟦暫定 Ctrl+F 出力
            mods = <(MOD_RALT)>;
        };

    // ======================================================================
    // B. 単独キー(28・40・41番)用: 右Ctrl/右Shift/右Alt(sticky)待機中に出力を切替
    //    命名: 入口(キーマップから呼ぶ)=機能名 mm_bs・mm_enter・mm_space / 内側=判定する修飾キー
    // ======================================================================

    // ---- 28番: 右Ctrl待機=Tab / 右Shift・右Alt待機=Ctrl+F / それ以外はBackspace ----
        mm_bs: mm_bs {
            compatible = "zmk,behavior-mod-morph";
            label = "MM_BS";
            #binding-cells = <0>;
            bindings = <&mm_bs_in>, <&kp TAB>;              // 28: 右Ctrl待機=Tab / それ以外は内側へ
            mods = <(MOD_RCTL)>;                            // keep-modsなし → 右Ctrlを外してTabだけ出す
        };

        mm_bs_in: mm_bs_in {
            compatible = "zmk,behavior-mod-morph";
            label = "MM_BS_IN";
            #binding-cells = <0>;
            bindings = <&kp BACKSPACE>, <&kp RC(F)>;        // 28: BS / 🟦暫定 右Shift・右Alt待機=Ctrl+F
            mods = <(MOD_RSFT|MOD_RALT)>;
        };

    // ---- 40番: 右Ctrl待機=ESC / 右Shift待機=Ctrl+F / 右Alt待機=F8 / それ以外はEnter(長押しNUMBER) ----
        mm_enter: mm_enter {
            compatible = "zmk,behavior-mod-morph";
            label = "MM_ENTER";
            #binding-cells = <0>;
            bindings = <&mm_enter_rs>, <&kp ESC>;           // 40: 右Ctrl待機=ESC / それ以外は内側1へ
            mods = <(MOD_RCTL)>;
        };

        mm_enter_rs: mm_enter_rs {
            compatible = "zmk,behavior-mod-morph";
            label = "MM_ENTER_RS";
            #binding-cells = <0>;
            bindings = <&mm_enter_ra>, <&kp RC(F)>;         // 40: 右Shift待機=🟦暫定 Ctrl+F / それ以外は内側2へ
            mods = <(MOD_RSFT)>;
        };

        mm_enter_ra: mm_enter_ra {
            compatible = "zmk,behavior-mod-morph";
            label = "MM_ENTER_RA";
            #binding-cells = <0>;
            bindings = <&ht_to L_NUMBER ENTER>, <&kp F8>;   // 40: Enter(長押しNUMBER) / 右Alt待機=F8
            mods = <(MOD_RALT)>;
        };

    // ======================================================================
    // C. combo(28+は行)用: 右Ctrl(sticky)待機中は半濁点(ぱ行)、なければ濁点(ば行)
    // ======================================================================

        mm_bi: mm_bi {
            compatible = "zmk,behavior-mod-morph";
            label = "MM_BI";
            #binding-cells = <0>;
            bindings = <&dkt V>, <&hdk V>;                  // ひ: び / 右Ctrl待機=ぴ
            mods = <(MOD_RCTL)>;
        };

        mm_be: mm_be {
            compatible = "zmk,behavior-mod-morph";
            label = "MM_BE";
            #binding-cells = <0>;
            bindings = <&dkt EQUAL>, <&hdk EQUAL>;          // へ: べ / 右Ctrl待機=ぺ
            mods = <(MOD_RCTL)>;
        };

    // ======================================================================
    // D. 拗音(1): 行キー単独(6/7/17/18/19/29/31番)用 → キーマップのCOFFEEレイヤーから直接呼ぶ
    //    右Shift(sticky)待機中は拗音(ゃ)、なければ元の清音
    // ======================================================================
        mm_kya: mm_kya {
            compatible = "zmk,behavior-mod-morph";
            label = "MM_KYA";
            #binding-cells = <0>;
            bindings = <&kp T>, <&yoon G SM_YA>;            // 6: か / 右Shift待機=きゃ
            mods = <(MOD_RSFT)>;                            // keep-modsなし → 右Shiftを外して出力
        };

        mm_sya: mm_sya {
            compatible = "zmk,behavior-mod-morph";
            label = "MM_SYA";
            #binding-cells = <0>;
            bindings = <&kp X>, <&yoon D SM_YA>;            // 7: さ / 右Shift待機=しゃ
            mods = <(MOD_RSFT)>;
        };

        mm_tya: mm_tya {
            compatible = "zmk,behavior-mod-morph";
            label = "MM_TYA";
            #binding-cells = <0>;
            bindings = <&kp Q>, <&yoon A SM_YA>;            // 17: た / 右Shift待機=ちゃ
            mods = <(MOD_RSFT)>;
        };

        mm_nya: mm_nya {
            compatible = "zmk,behavior-mod-morph";
            label = "MM_NYA";
            #binding-cells = <0>;
            bindings = <&kp U>, <&yoon I SM_YA>;            // 18: な / 右Shift待機=にゃ
            mods = <(MOD_RSFT)>;
        };

        mm_hya: mm_hya {
            compatible = "zmk,behavior-mod-morph";
            label = "MM_HYA";
            #binding-cells = <0>;
            bindings = <&kp F>, <&yoon V SM_YA>;            // 19: は / 右Shift待機=ひゃ
            mods = <(MOD_RSFT)>;
        };

        mm_mya: mm_mya {
            compatible = "zmk,behavior-mod-morph";
            label = "MM_MYA";
            #binding-cells = <0>;
            bindings = <&kp J>, <&yoon N SM_YA>;            // 29: ま / 右Shift待機=みゃ
            mods = <(MOD_RSFT)>;
        };

        mm_rya: mm_rya {
            compatible = "zmk,behavior-mod-morph";
            label = "MM_RYA";
            #binding-cells = <0>;
            bindings = <&kp O>, <&yoon L SM_YA>;            // 31: ら / 右Shift待機=りゃ
            mods = <(MOD_RSFT)>;
        };

    // ======================================================================
    // E. 拗音(2): 行キー+20番(ゅ)/32番(ょ)のcombo用 → 既存の清音comboから呼ぶ
    //    右Shift(sticky)待機中は拗音、なければ元の清音(く・こ ほか)
    // ======================================================================
        mm_kyu: mm_kyu {
            compatible = "zmk,behavior-mod-morph";
            label = "MM_KYU";
            #binding-cells = <0>;
            bindings = <&kp H>, <&yoon G SM_YU>;            // 6+20: く / 右Shift待機=きゅ
            mods = <(MOD_RSFT)>;
        };

        mm_kyo: mm_kyo {
            compatible = "zmk,behavior-mod-morph";
            label = "MM_KYO";
            #binding-cells = <0>;
            bindings = <&kp B>, <&yoon G SM_YO>;            // 6+32: こ / 右Shift待機=きょ
            mods = <(MOD_RSFT)>;
        };

        mm_syu: mm_syu {
            compatible = "zmk,behavior-mod-morph";
            label = "MM_SYU";
            #binding-cells = <0>;
            bindings = <&kp R>, <&yoon D SM_YU>;            // 7+20: す / 右Shift待機=しゅ
            mods = <(MOD_RSFT)>;
        };

        mm_syo: mm_syo {
            compatible = "zmk,behavior-mod-morph";
            label = "MM_SYO";
            #binding-cells = <0>;
            bindings = <&kp C>, <&yoon D SM_YO>;            // 7+32: そ / 右Shift待機=しょ
            mods = <(MOD_RSFT)>;
        };

        mm_tyu: mm_tyu {
            compatible = "zmk,behavior-mod-morph";
            label = "MM_TYU";
            #binding-cells = <0>;
            bindings = <&kp Z>, <&yoon A SM_YU>;            // 17+20: つ / 右Shift待機=ちゅ
            mods = <(MOD_RSFT)>;
        };

        mm_tyo: mm_tyo {
            compatible = "zmk,behavior-mod-morph";
            label = "MM_TYO";
            #binding-cells = <0>;
            bindings = <&kp S>, <&yoon A SM_YO>;            // 17+32: と / 右Shift待機=ちょ
            mods = <(MOD_RSFT)>;
        };

        mm_nyu: mm_nyu {
            compatible = "zmk,behavior-mod-morph";
            label = "MM_NYU";
            #binding-cells = <0>;
            bindings = <&kp N1>, <&yoon I SM_YU>;           // 18+20: ぬ / 右Shift待機=にゅ
            mods = <(MOD_RSFT)>;
        };

        mm_nyo: mm_nyo {
            compatible = "zmk,behavior-mod-morph";
            label = "MM_NYO";
            #binding-cells = <0>;
            bindings = <&kp K>, <&yoon I SM_YO>;            // 18+32: の / 右Shift待機=にょ
            mods = <(MOD_RSFT)>;
        };

        mm_hyu: mm_hyu {
            compatible = "zmk,behavior-mod-morph";
            label = "MM_HYU";
            #binding-cells = <0>;
            bindings = <&kp N2>, <&yoon V SM_YU>;           // 19+20: ふ / 右Shift待機=ひゅ
            mods = <(MOD_RSFT)>;
        };

        mm_hyo: mm_hyo {
            compatible = "zmk,behavior-mod-morph";
            label = "MM_HYO";
            #binding-cells = <0>;
            bindings = <&kp MINUS>, <&yoon V SM_YO>;        // 19+32: ほ / 右Shift待機=ひょ
            mods = <(MOD_RSFT)>;
        };

        mm_myu: mm_myu {
            compatible = "zmk,behavior-mod-morph";
            label = "MM_MYU";
            #binding-cells = <0>;
            bindings = <&kp NON_US_HASH>, <&yoon N SM_YU>;  // 29+20: む / 右Shift待機=みゅ
            mods = <(MOD_RSFT)>;
        };

        mm_myo: mm_myo {
            compatible = "zmk,behavior-mod-morph";
            label = "MM_MYO";
            #binding-cells = <0>;
            bindings = <&kp M>, <&yoon N SM_YO>;            // 29+32: も / 右Shift待機=みょ
            mods = <(MOD_RSFT)>;
        };

        mm_ryu: mm_ryu {
            compatible = "zmk,behavior-mod-morph";
            label = "MM_RYU";
            #binding-cells = <0>;
            bindings = <&kp PERIOD>, <&yoon L SM_YU>;       // 31+20: る / 右Shift待機=りゅ
            mods = <(MOD_RSFT)>;
        };

        mm_ryo: mm_ryo {
            compatible = "zmk,behavior-mod-morph";
            label = "MM_RYO";
            #binding-cells = <0>;
            bindings = <&kp INT1>, <&yoon L SM_YO>;         // 31+32: ろ / 右Shift待機=りょ
            mods = <(MOD_RSFT)>;
        };

    // ======================================================================
    // F. 濁音拗音: ⌫(28番)+行キー[+母音キー]のcombo用（が・ざ・だ行）
    //    右Shift(sticky)待機中は濁音拗音、なければ元の濁音
    // ======================================================================
        mm_gya: mm_gya {
            compatible = "zmk,behavior-mod-morph";
            label = "MM_GYA";
            #binding-cells = <0>;
            bindings = <&dkt T>, <&yoon_dk G SM_YA>;        // 28+6: が / 右Shift待機=ぎゃ
            mods = <(MOD_RSFT)>;
        };

        mm_gyu: mm_gyu {
            compatible = "zmk,behavior-mod-morph";
            label = "MM_GYU";
            #binding-cells = <0>;
            bindings = <&dkt H>, <&yoon_dk G SM_YU>;        // 28+6+20: ぐ / 右Shift待機=ぎゅ
            mods = <(MOD_RSFT)>;
        };

        mm_gyo: mm_gyo {
            compatible = "zmk,behavior-mod-morph";
            label = "MM_GYO";
            #binding-cells = <0>;
            bindings = <&dkt B>, <&yoon_dk G SM_YO>;        // 28+6+32: ご / 右Shift待機=ぎょ
            mods = <(MOD_RSFT)>;
        };

        mm_zya: mm_zya {
            compatible = "zmk,behavior-mod-morph";
            label = "MM_ZYA";
            #binding-cells = <0>;
            bindings = <&dkt X>, <&yoon_dk D SM_YA>;        // 28+7: ざ / 右Shift待機=じゃ
            mods = <(MOD_RSFT)>;
        };

        mm_zyu: mm_zyu {
            compatible = "zmk,behavior-mod-morph";
            label = "MM_ZYU";
            #binding-cells = <0>;
            bindings = <&dkt R>, <&yoon_dk D SM_YU>;        // 28+7+20: ず / 右Shift待機=じゅ
            mods = <(MOD_RSFT)>;
        };

        mm_zyo: mm_zyo {
            compatible = "zmk,behavior-mod-morph";
            label = "MM_ZYO";
            #binding-cells = <0>;
            bindings = <&dkt C>, <&yoon_dk D SM_YO>;        // 28+7+32: ぞ / 右Shift待機=じょ
            mods = <(MOD_RSFT)>;
        };

        mm_dya: mm_dya {
            compatible = "zmk,behavior-mod-morph";
            label = "MM_DYA";
            #binding-cells = <0>;
            bindings = <&dkt Q>, <&yoon_dk A SM_YA>;        // 28+17: だ / 右Shift待機=ぢゃ
            mods = <(MOD_RSFT)>;
        };

        mm_dyu: mm_dyu {
            compatible = "zmk,behavior-mod-morph";
            label = "MM_DYU";
            #binding-cells = <0>;
            bindings = <&dkt Z>, <&yoon_dk A SM_YU>;        // 28+17+20: づ / 右Shift待機=ぢゅ
            mods = <(MOD_RSFT)>;
        };

        mm_dyo: mm_dyo {
            compatible = "zmk,behavior-mod-morph";
            label = "MM_DYO";
            #binding-cells = <0>;
            bindings = <&dkt S>, <&yoon_dk A SM_YO>;        // 28+17+32: ど / 右Shift待機=ぢょ
            mods = <(MOD_RSFT)>;
        };

    // ======================================================================
    // G. ば行・ぱ行・びゃ行・ぴゃ行: ⌫(28番)+は(19番)[+母音キー]のcombo用
    //    ※前回の mm_ba / mm_bu / mm_bo をこの定義に【置き換え】（mm_bi / mm_be はそのまま）
    //    入口(mm_b*)=右Ctrl判定 → 内側(mm_rs_*)=右Shift判定
    //    なし=ば行 / 右Shift=びゃ行 / 右Ctrl=ぱ行 / 右Ctrl→右Shift=ぴゃ行
    // ======================================================================
        mm_ba: mm_ba {
            compatible = "zmk,behavior-mod-morph";
            label = "MM_BA";
            #binding-cells = <0>;
            bindings = <&mm_rs_ba>, <&mm_rs_pa>;            // 28+19: 右Ctrl待機なし=内側(ば系) / あり=内側(ぱ系)
            mods = <(MOD_RCTL)>;                            // keep-modsなし → 右Ctrlを外して出力
        };

        mm_bu: mm_bu {
            compatible = "zmk,behavior-mod-morph";
            label = "MM_BU";
            #binding-cells = <0>;
            bindings = <&mm_rs_bu>, <&mm_rs_pu>;            // 28+19+20: 右Ctrl待機なし=内側(ぶ系) / あり=内側(ぷ系)
            mods = <(MOD_RCTL)>;
        };

        mm_bo: mm_bo {
            compatible = "zmk,behavior-mod-morph";
            label = "MM_BO";
            #binding-cells = <0>;
            bindings = <&mm_rs_bo>, <&mm_rs_po>;            // 28+19+32: 右Ctrl待機なし=内側(ぼ系) / あり=内側(ぽ系)
            mods = <(MOD_RCTL)>;
        };

        mm_rs_ba: mm_rs_ba {
            compatible = "zmk,behavior-mod-morph";
            label = "MM_RS_BA";
            #binding-cells = <0>;
            bindings = <&dkt F>, <&yoon_dk V SM_YA>;        // は: ば / 右Shift待機=びゃ
            mods = <(MOD_RSFT)>;
        };

        mm_rs_pa: mm_rs_pa {
            compatible = "zmk,behavior-mod-morph";
            label = "MM_RS_PA";
            #binding-cells = <0>;
            bindings = <&hdk F>, <&yoon_hd V SM_YA>;        // は: ぱ / 右Shift待機=ぴゃ
            mods = <(MOD_RSFT)>;
        };

        mm_rs_bu: mm_rs_bu {
            compatible = "zmk,behavior-mod-morph";
            label = "MM_RS_BU";
            #binding-cells = <0>;
            bindings = <&dkt N2>, <&yoon_dk V SM_YU>;       // ふ: ぶ / 右Shift待機=びゅ
            mods = <(MOD_RSFT)>;
        };

        mm_rs_pu: mm_rs_pu {
            compatible = "zmk,behavior-mod-morph";
            label = "MM_RS_PU";
            #binding-cells = <0>;
            bindings = <&hdk N2>, <&yoon_hd V SM_YU>;       // ふ: ぷ / 右Shift待機=ぴゅ
            mods = <(MOD_RSFT)>;
        };

        mm_rs_bo: mm_rs_bo {
            compatible = "zmk,behavior-mod-morph";
            label = "MM_RS_BO";
            #binding-cells = <0>;
            bindings = <&dkt MINUS>, <&yoon_dk V SM_YO>;    // ほ: ぼ / 右Shift待機=びょ
            mods = <(MOD_RSFT)>;
        };

        mm_rs_po: mm_rs_po {
            compatible = "zmk,behavior-mod-morph";
            label = "MM_RS_PO";
            #binding-cells = <0>;
            bindings = <&hdk MINUS>, <&yoon_hd V SM_YO>;    // ほ: ぽ / 右Shift待機=ぴょ
            mods = <(MOD_RSFT)>;
        };


    // ---- 41番: 右Ctrl・右Shift・右Alt待機=Ctrl+F / それ以外はSpace(長押しQWERTY_RIGHT) ----
        mm_space: mm_space {
            compatible = "zmk,behavior-mod-morph";
            label = "MM_SPACE";
            #binding-cells = <0>;
            bindings = <&ht_to L_QWERTY_RIGHT SPACE>, <&kp RC(F)>;  // 41: Space(長押しQWERTY_RIGHT) / 🟦暫定 待機中=Ctrl+F
            mods = <(MOD_RCTL|MOD_RSFT|MOD_RALT)>;
        };

    };



    keymap {
        compatible = "zmk,keymap";

// -------------------------------------------------------------
// 🟩🟩🟩 珈琲配列 🟩🟩🟩
// -------------------------------------------------------------

        COFFEE {         // Layer 0
            bindings = <
&to L_BT_SETTING  &trans  &trans  &trans        &trans                             &kp N3     &mm_kya  &mm_sya  &kp LSHFT    &kp INT3
&trans            &trans  &trans  &trans        &trans    &trans        &kp Y      &mm_tya    &mm_nya  &mm_hya  &kp INT6     &sk RCTRL
&trans            &trans  &trans  &trans        &trans    &trans        &mm_bs     &mm_mya    &kp N7   &mm_rya  &kp RS(DOT)  &sk RSHFT
&to L_MOUSE       &trans  &trans  &kp LS(INT5)  &kp INT5  &kp INT4      &mm_enter  &mm_space                                 &sk RALT
            >;

            sensor-bindings = <&ROTATE SCRL_DOWN SCRL_UP>;
        };

        QWERTY_RIGHT {   // Layer 1
            bindings = <
&trans  &trans  &trans  &trans  &trans                         &kp U      &kp I      &kp O       &kp P          &kp Y
&trans  &trans  &trans  &trans  &trans  &trans      &kp H      &kp J      &kp K      &kp L       &kp BACKSPACE  &kp RCTRL
&none   &trans  &trans  &trans  &trans  &trans      &kp N      &kp M      &kp COMMA  &kp PERIOD  &none          &kp RSHFT
&trans  &trans  &trans  &trans  &trans  &trans      &kp ENTER  &kp SPACE                                        &to L_COFFEE
            >;
        };

        QWERTY_LEFT {    // Layer 2
            bindings = <
&trans  &trans  &trans  &trans  &trans                         &kp R      &kp E  &kp W  &kp Q  &kp T
&trans  &trans  &trans  &trans  &trans  &trans      &kp G      &kp F      &kp D  &kp S  &kp A  &kp RCTRL
&none   &trans  &trans  &trans  &trans  &trans      &kp B      &kp V      &kp C  &kp X  &kp Z  &kp RSHFT
&trans  &trans  &trans  &trans  &trans  &trans      &kp ENTER  &kp SPACE                       &to L_COFFEE
            >;
        };

        NUMBER {         // Layer 3
            bindings = <
&trans  &trans  &trans  &trans  &trans                            &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp MINUS   &kp SLASH                            
&trans  &trans  &trans  &trans  &trans  &trans      &to L_SIMBOL  &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp PLUS    &kp ASTERISK
&trans  &trans  &trans  &trans  &trans  &trans      &kp NUMBER_0  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp PERIOD  &kp EQUAL
&trans  &trans  &trans  &trans  &trans  &trans      &kp ENTER     &kp SPACE                                             &to L_COFFEE
            >;
        };

        SIMBOL {         // Layer 4
            bindings = <
&trans  &trans  &trans  &trans  &trans                           &kp CARET         &kp AMPERSAND      &kp TILDE       &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS
&trans  &trans  &trans  &trans  &trans  &trans      &to L_NUMBER &kp EXCLAMATION   &kp AT_SIGN        &kp HASH        &kp DOLLAR            &kp PERCENT
&trans  &trans  &trans  &trans  &trans  &trans      &kp PIPE     &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp LEFT_BRACE  &kp RIGHT_BRACE       &kp UNDERSCORE
&trans  &trans  &trans  &trans  &trans  &trans      &kp ENTER    &kp SPACE                                                                  &to L_COFFEE
            >;
        };

        FUNCTION {       // Layer 5 🟥🟥🟥 未配置 🟥🟥🟥
            bindings = <
&kp F1   &kp F2  &kp F3  &kp F4  &kp F5                        &kp F1  &kp F2  &kp F3  &kp F4  &kp F5
&kp F6   &kp F7  &kp F8  &kp F9  &kp F10  &trans      &kp F13  &kp F6  &kp F7  &kp F8  &kp F9  &kp F10
&kp F11  &trans  &trans  &trans  &trans   &trans      &trans   &trans  &trans  &trans  &trans  &kp F11
&kp F12  &trans  &trans  &trans  &trans   &trans      &trans   &trans                          &kp F12
            >;
        };

        TRACKBALL {      // Layer 6
            bindings = <
&trans              &trans     &kp LC(PAGE_UP)  &kp LC(PAGE_DOWN)  &kp LC(W)                                 &kp LC(LS(TAB))  &trans     &kp LC(TAB)  &trans        &trans 
&lt L_SCROLL SPACE  &kp SPACE  &mkp LCLK        &mkp RCLK          &mkp MCLK  &mkp RCLK      &msc SCRL_UP    &mkp LCLK        &mkp MCLK  &mkp RCLK    &mo L_SCROLL  &trans
&trans              &trans     &trans           &trans             &trans     &mkp LCLK      &msc SCRL_DOWN  &mkp MB4         &mkp MB5   &kp LC(W)    &trans        &trans
&trans              &trans     &trans           &trans             &trans     &trans         &trans          &trans                                                 &trans
            >;
        };

        SCROLL {         // Layer 7
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&none   &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };

        BT_SETTING {     // Layer 8
            bindings = <
&to L_COFFEE  &trans        &trans        &trans        &trans                                    &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans        &trans        &trans        &trans        &trans        &trans      &studio_unlock  &trans        &trans        &trans        &trans        &trans
&trans        &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &trans      &bootloader     &trans        &trans        &trans        &trans        &bt BT_CLR
&trans        &trans        &trans        &trans        &trans        &trans      &trans          &trans                                                  &bt BT_CLR_ALL
            >;
        };

    // マウスレイヤー

        MOUSE {          // Layer 9
            bindings = <
&trans  &trans  &trans  &trans  &trans                         &kp LC(LS(TAB))  &mmv MOVE_UP    &kp LC(TAB)      &msc SCRL_LEFT    &msc SCRL_RIGHT
&trans  &trans  &trans  &trans  &trans  &trans      &trans     &mmv MOVE_LEFT   &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &mo L_MOUSE_FAST  &msc SCRL_UP
&none   &trans  &trans  &trans  &trans  &trans      &mkp MCLK  &mkp MB4         &mkp MB5        &trans           &mo L_MOUSE_SLOW  &msc SCRL_DOWN
&trans  &trans  &trans  &trans  &trans  &trans      &mkp RCLK                   &mkp LCLK                                          &to L_COFFEE
            >;
        };

        MOUSE_SLOW {     // Layer 10
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans          &mmv SLOW_UP    &trans           &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &mmv SLOW_LEFT  &mmv SLOW_DOWN  &mmv SLOW_RIGHT  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans          &trans          &trans           &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                                           &trans
            >;
        };

        MOUSE_FAST {    // Layer 11
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans          &mmv FAST_UP    &trans           &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &mmv FAST_LEFT  &mmv FAST_DOWN  &mmv FAST_RIGHT  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans          &trans          &trans           &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                                                   &trans
            >;
        };

        ARROW {         // Layer 12 🟥🟥🟥 不要の場合削除 🟥🟥🟥
            bindings = <
&trans  &trans  &trans  &trans  &trans                              &kp LC(LS(TAB))         &kp UP_ARROW     &kp LC(TAB)              &kp ESCAPE   &trans
&trans  &trans  &trans  &trans  &trans  &trans      &kp HOME        &kp LEFT_ARROW          &kp DOWN_ARROW   &kp RIGHT_ARROW          &kp END      &trans
&trans  &trans  &trans  &trans  &trans  &trans      &kp LEFT_SHIFT  &kp LG(LS(LEFT_ARROW))  &trans           &kp LG(LS(RIGHT_ARROW))  &trans       &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans          &trans                                                                         &to L_COFFEE
            >;
        };

    };
};
