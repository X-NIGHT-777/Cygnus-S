#define ZMK_POINTING_DEFAULT_SCRL_VAL 120    // default: 10

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define MOUSE 4
#define SCROLL 5
#define NUM 6
#define FUJIN_BASE 7
#define FUJIN_VOWEL 8

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

/ {



    combos {
        compatible = "zmk,combos";

        // --- 既存のコンボ --- //
        double_quotation {
            bindings = <&kp DOUBLE_QUOTES>;
            key-positions = <20 21>;
        };

        // =============================================================
        // 風神配列：文字キー同士の同時代行・ロールオーバーコンボ
        // =============================================================

        // --- 子音 + 無変換キー (35) = 'u' ---
        combo_c_muhenkan {
            timeout-ms = <50>;
            key-positions = <26 35>; // C(26) + 無変換(35)
            bindings = <&kp U>;
            layers = <FUJIN_BASE>;
        };

        combo_b_muhenkan {
            timeout-ms = <50>;
            key-positions = <28 35>; // B(28) + 無変換(35)
            bindings = <&kp U>;
            layers = <FUJIN_BASE>;
        };

        // --- 子音 + 母音行キー (A, S, D, F) の同時代行 ---
        
        // C (B) + S (13) = 'u' (「ぶ」入力用)
        combo_c_s {
            timeout-ms = <50>;
            key-positions = <26 13>;
            bindings = <&kp U>;
            layers = <FUJIN_BASE>;
        };

        // B (J) + S (13) = 'u' (「じゅ」入力用)
        combo_b_s {
            timeout-ms = <50>;
            key-positions = <28 13>;
            bindings = <&kp U>;
            layers = <FUJIN_BASE>;
        };

        // =============================================================
        // 風神配列：子音キー + Space の全コンボ定義 (レイヤー7限定)
        // =============================================================

        // --- 上段 (Top Row) ---
        // Q (M) + Space -> e
        combo_q_spc {
            timeout-ms = <50>;
            key-positions = <0 38>;
            bindings = <&kp E>;
            layers = <FUJIN_BASE>;
        };

        // W (Y) + Space -> i
        combo_w_spc {
            timeout-ms = <50>;
            key-positions = <1 38>;
            bindings = <&kp I>;
            layers = <FUJIN_BASE>;
        };

        // E (R) + Space -> o
        combo_e_spc {
            timeout-ms = <50>;
            key-positions = <2 38>;
            bindings = <&kp O>;
            layers = <FUJIN_BASE>;
        };

        // R (W) + Space -> a
        combo_r_spc {
            timeout-ms = <50>;
            key-positions = <3 38>;
            bindings = <&kp A>;
            layers = <FUJIN_BASE>;
        };

        // T (P) + Space -> a
        combo_t_spc {
            timeout-ms = <50>;
            key-positions = <4 38>;
            bindings = <&kp A>;
            layers = <FUJIN_BASE>;
        };

        // Y (X) + Space -> a
        combo_y_spc {
            timeout-ms = <50>;
            key-positions = <5 38>;
            bindings = <&kp A>;
            layers = <FUJIN_BASE>;
        };

        // --- 中段 (Home Row) ---
        // A (K) + Space -> e
        combo_a_spc {
            timeout-ms = <50>;
            key-positions = <12 38>;
            bindings = <&kp E>;
            layers = <FUJIN_BASE>;
        };

        // S (S) + Space -> i
        combo_s_spc {
            timeout-ms = <50>;
            key-positions = <13 38>;
            bindings = <&kp I>;
            layers = <FUJIN_BASE>;
        };

        // D (T) + Space -> o
        combo_d_spc {
            timeout-ms = <50>;
            key-positions = <14 38>;
            bindings = <&kp O>;
            layers = <FUJIN_BASE>;
        };

        // F (N) + Space -> a (「な」)
        combo_f_spc {
            timeout-ms = <50>;
            key-positions = <15 38>;
            bindings = <&kp A>;
            layers = <FUJIN_BASE>;
        };

        // G (H) + Space -> a
        combo_g_spc {
            timeout-ms = <50>;
            key-positions = <16 38>;
            bindings = <&kp A>;
            layers = <FUJIN_BASE>;
        };

        // --- 下段 (Bottom Row) ---
        // Z (Z) + Space -> e
        combo_z_spc {
            timeout-ms = <50>;
            key-positions = <24 38>;
            bindings = <&kp E>;
            layers = <FUJIN_BASE>;
        };

        // X (D) + Space -> i
        combo_x_spc {
            timeout-ms = <50>;
            key-positions = <25 38>;
            bindings = <&kp I>;
            layers = <FUJIN_BASE>;
        };

        // C (B) + Space -> u (spaceVowel = "u")
        combo_c_spc {
            timeout-ms = <50>;
            key-positions = <26 38>;
            bindings = <&kp U>;
            layers = <FUJIN_BASE>;
        };

        // V (G) + Space -> a
        combo_v_spc {
            timeout-ms = <50>;
            key-positions = <27 38>;
            bindings = <&kp A>;
            layers = <FUJIN_BASE>;
        };

        // B (J) + Space -> u (spaceVowel = "u")
        combo_b_spc {
            timeout-ms = <50>;
            key-positions = <28 38>;
            bindings = <&kp U>;
            layers = <FUJIN_BASE>;
        };
    };



    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };
    };



    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        ROTATE: ROTATE {
            compatible = "zmk,behavior-sensor-rotate-var";
            label = "ROTATE";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;

            tap-ms = <20>;
        };

        // 風神配列用：Space長押しでFUJIN_VOWEL(8)、TapでSpace出力
        lt_spc: lt_spc {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_SPACE";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&mo>, <&kp>;
        };
    };



    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q             &kp W         &kp E         &kp R                 &kp T                                                                 &kp Y        &kp U  &kp I      &kp O    &kp P
&kp A             &kp S         &kp D         &kp F                 &kp G        &mkp RCLK                  &kp UP_ARROW    &kp H        &kp J  &kp K      &lt 4 L  &lt 5 MINUS
&mt LEFT_SHIFT Z  &kp X         &kp C         &kp V                 &kp B        &mkp LCLK                  &kp DOWN_ARROW  &kp N        &kp M  &kp COMMA  &kp DOT  &mt LEFT_SHIFT SLASH
&kp LCTRL         &kp LEFT_WIN  &kp LEFT_ALT  &lt 6 INTERNATIONAL_4 &lt 1 SPACE  &lt 3 INTERNATIONAL_5      &kp BACKSPACE   &lt 2 ENTER                    &tog 7
            >;

            sensor-bindings = <&ROTATE SCRL_DOWN SCRL_UP>;
        };

        FUNCTION {
            bindings = <
&kp F1   &kp F2  &kp F3  &kp F4  &kp F5                        &kp F1  &kp F2  &kp F3  &kp F4  &kp F5
&kp F6   &kp F7  &kp F8  &kp F9  &kp F10  &trans      &kp F13  &kp F6  &kp F7  &kp F8  &kp F9  &kp F10
&kp F11  &trans  &trans  &trans  &trans   &trans      &trans   &trans  &trans  &trans  &trans  &kp F11
&kp F12  &trans  &trans  &trans  &trans   &trans      &trans   &trans                          &kp F12
            >;
        };

        NUM {
            bindings = <
&kp MINUS                   &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp PLUS                                     &kp CARET        &kp AMPERSAND      &kp TILDE       &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS
&kp SLASH                   &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp ASTERISK  &trans       &kp UNDERSCORE  &kp EXCLAMATION  &kp AT_SIGN        &kp HASH        &kp DOLLAR            &kp PERCENT
&mt LEFT_SHIFT KP_NUMBER_0  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp PERIOD    &kp EQUAL    &trans          &kp LEFT_BRACKET &kp RIGHT_BRACKET  &kp LEFT_BRACE  &kp RIGHT_BRACE       &kp BACKSLASH
&trans                      &trans           &trans           &trans           &trans        &trans       &trans          &trans                                                                    &kp PIPE
            >;
        };

        ARROW {
            bindings = <
&kp ESCAPE      &kp LC(LS(TAB))         &kp UP_ARROW    &kp LC(TAB)              &trans                       &trans  &trans  &trans  &trans  &trans
&kp HOME        &kp LEFT_ARROW          &kp DOWN_ARROW  &kp RIGHT_ARROW          &kp END  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&kp LEFT_SHIFT  &kp LG(LS(LEFT_ARROW))  &trans          &kp LG(LS(RIGHT_ARROW))  &trans   &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans          &trans                  &trans          &trans                   &trans   &trans      &trans  &trans                          &trans
            >;

            sensor-bindings = <&inc_dec_kp LC(PAGE_UP) LC(PAGE_DOWN)>;
        };

        MOUSE {
            bindings = <
&trans       &trans       &kp LC(PAGE_UP)  &kp LC(PAGE_DOWN)  &kp LC(W)                         &kp LC(W)  &kp LC(PAGE_UP)  &kp LC(PAGE_DOWN)  &trans       &trans
&lt 5 SPACE  &lt 4 SPACE  &mkp LCLK        &mkp RCLK          &mkp MCLK  &mkp RCLK    &trans    &mkp MCLK  &mkp LCLK        &mkp RCLK          &lt 4 SPACE  &lt 5 SPACE
&trans       &trans       &trans           &trans             &trans     &mkp LCLK    &trans    &trans     &mkp MB4         &mkp MB5           &trans       &trans
&trans       &trans       &trans           &trans             &trans     &trans       &trans    &trans                                                      &trans
            >;
        };

        SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&none   &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };

        layer_6 {
            bindings = <
&trans  &trans        &trans        &trans        &trans                               &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans  &trans        &trans        &trans        &trans        &trans  &studio_unlock &trans        &trans        &trans        &trans        &trans
&trans  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kt KP_N4     &trans  &bootloader    &trans        &trans        &trans        &trans        &bt BT_CLR
&trans  &trans        &trans        &trans        &trans        &trans  &trans         &trans                                                  &bt BT_CLR_ALL
            >;
        };

        FUJIN_BASE {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &kp W                      &kp R      &kp Y  &kp M  &kp P
&trans  &trans  &trans  &trans  &trans  &trans      &kp H   &kp N                      &kp T      &kp S  &kp K  &kp CAPSLOCK
&trans  &trans  &trans  &trans  &trans  &trans      &kp J   &kp G                      &kp B      &kp D  &kp Z  &kp RSHFT
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &lt_spc FUJIN_VOWEL SPACE                    &tog 7
            >;
        };

        FUJIN_VOWEL {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &kp U   &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &kp O   &kp A   &kp I   &kp E   &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };
    };
};
