#define ZMK_POINTING_DEFAULT_SCRL_VAL 120    // default: 10

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define L_QWERTY_DEFAULT           0
#define L_NUM_DEFAULT              1
#define L_ARROW_DEFAULT            2
#define L_MOUSE                    3
#define L_SCROLL                   4
#define L_FUNCTION                 5
#define L_BT_SETTING               6
#define L_COFFEE                   7  // COFFE FLICK
#define L_QWERTY_RIGHT             8  // QWERTY RIGHT
#define L_QWERTY_LEFT              9  // QWERTY LEFT
#define L_NUMBER                  10  // NUMBER
#define L_SIMBOL                  11  // SIMBOL
#define L_ARROW                   12  // ARROW

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

/ {



    combos {
        compatible = "zmk,combos";

    // あ行：N3
    combo_a_i { key-positions = <5 40>; layers = <L_COFFEE>; bindings = <&kp E>; };
    combo_a_u { key-positions = <5 20>; layers = <L_COFFEE>; bindings = <&kp N4>; };
    combo_a_e { key-positions = <5 41>; layers = <L_COFFEE>; bindings = <&kp N5>; };
    combo_a_o { key-positions = <5 32>; layers = <L_COFFEE>; bindings = <&kp N6>; };

    // か行：T
    combo_ka_i { key-positions = <6 40>; layers = <L_COFFEE>; bindings = <&kp G>; };
    combo_ka_u { key-positions = <6 20>; layers = <L_COFFEE>; bindings = <&kp H>; };
    combo_ka_e { key-positions = <6 41>; layers = <L_COFFEE>; bindings = <&kp SQT>;  };
    combo_ka_o { key-positions = <6 32>; layers = <L_COFFEE>; bindings = <&kp B>; };

    // さ行：X
    combo_sa_i { key-positions = <7 40>; layers = <L_COFFEE>; bindings = <&kp D>; };
    combo_sa_u { key-positions = <7 20>; layers = <L_COFFEE>; bindings = <&kp R>; };
    combo_sa_e { key-positions = <7 41>; layers = <L_COFFEE>; bindings = <&kp P>; };
    combo_sa_o { key-positions = <7 32>; layers = <L_COFFEE>; bindings = <&kp C>; };

    // た行：Q
    combo_ta_i { key-positions = <17 40>; layers = <L_COFFEE>; bindings = <&kp A>; };
    combo_ta_u { key-positions = <17 20>; layers = <L_COFFEE>; bindings = <&kp Z>; };
    combo_ta_e { key-positions = <17 41>; layers = <L_COFFEE>; bindings = <&kp W>; };
    combo_ta_o { key-positions = <17 32>; layers = <L_COFFEE>; bindings = <&kp S>; };

    // な行：U
    combo_na_i { key-positions = <18 40>; layers = <L_COFFEE>; bindings = <&kp I>; };
    combo_na_u { key-positions = <18 20>; layers = <L_COFFEE>; bindings = <&kp N1>; };
    combo_na_e { key-positions = <18 41>; layers = <L_COFFEE>; bindings = <&kp COMMA>; };
    combo_na_o { key-positions = <18 32>; layers = <L_COFFEE>; bindings = <&kp K>; };

    // は行：F
    combo_ha_i { key-positions = <19 40>; layers = <L_COFFEE>; bindings = <&kp V>; };
    combo_ha_u { key-positions = <19 20>; layers = <L_COFFEE>; bindings = <&kp N2>; };
    combo_ha_e { key-positions = <19 41>; layers = <L_COFFEE>; bindings = <&kp EQUAL>; };
    combo_ha_o { key-positions = <19 32>; layers = <L_COFFEE>; bindings = <&kp MINUS>; };

    // ま行：J
    combo_ma_i { key-positions = <29 40>; layers = <L_COFFEE>; bindings = <&kp N>; };
    combo_ma_u { key-positions = <29 20>; layers = <L_COFFEE>; bindings = <&kp NON_US_HASH>; };
    combo_ma_e { key-positions = <29 41>; layers = <L_COFFEE>; bindings = <&kp SLASH>; };
    combo_ma_o { key-positions = <29 32>; layers = <L_COFFEE>; bindings = <&kp M>; };

    // や行：N7（ゆ・よのみ）
    combo_ya_u { key-positions = <30 20>; layers = <L_COFFEE>; bindings = <&kp N8>; };
    combo_ya_o { key-positions = <30 32>; layers = <L_COFFEE>; bindings = <&kp N9>; };

    // ら行：O
    combo_ra_i { key-positions = <31 40>; layers = <L_COFFEE>; bindings = <&kp L>; };
    combo_ra_u { key-positions = <31 20>; layers = <L_COFFEE>; bindings = <&kp PERIOD>; };
    combo_ra_e { key-positions = <31 41>; layers = <L_COFFEE>; bindings = <&kp SEMICOLON>; };
    combo_ra_o { key-positions = <31 32>; layers = <L_COFFEE>; bindings = <&kp INT1>; };

    // わ行：N0（を）
    combo_wa_o { key-positions = <28 32>; layers = <L_COFFEE>; bindings = <&kp LS(N0)>; };

    // 濁点・半濁点：LSHFT(8) との組み合わせ
    combo_dakuten    { key-positions = <8 40>; layers = <L_COFFEE>; bindings = <&kp LEFT_BRACKET>;  };  // ゛
    combo_handakuten { key-positions = <8 41>; layers = <L_COFFEE>; bindings = <&kp RIGHT_BRACKET>; };  // ゜

    };



    macros {
    // Macroエリア
    };



    behaviors {

        ROTATE: ROTATE {
            compatible = "zmk,behavior-sensor-rotate-var";
            label = "ROTATE";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;

            tap-ms = <20>;
        };

    };



    keymap {
        compatible = "zmk,keymap";

        QWERTY {
            bindings = <
&kp Q             &kp W         &kp E         &kp R                             &kp T                                                                  &kp Y        &kp U  &kp I      &kp O          &kp P
&kp A             &kp S         &kp D         &kp F                             &kp G                 &mkp RCLK                        &kp UP_ARROW    &kp H        &kp J  &kp K      &lt L_MOUSE L  &lt L_SCROLL MINUS
&mt LEFT_SHIFT Z  &kp X         &kp C         &kp V                             &kp B                 &mkp LCLK                        &kp DOWN_ARROW  &kp N        &kp M  &kp COMMA  &kp DOT        &mt LEFT_SHIFT SLASH
&kp LCTRL         &kp LEFT_WIN  &kp LEFT_ALT  &lt L_BT_SETTING INTERNATIONAL_4  &lt L_FUNCTION SPACE  &lt L_ARROW INTERNATIONAL_5      &kp BACKSPACE   &lt L_NUM ENTER                               &kp DEL
            >;

            sensor-bindings = <&ROTATE SCRL_DOWN SCRL_UP>;
        };

        NUM {
            bindings = <
&kp MINUS                   &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp PLUS                                     &kp CARET         &kp AMPERSAND      &kp TILDE       &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS
&kp SLASH                   &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp ASTERISK  &trans         &kp UNDERSCORE  &kp EXCLAMATION   &kp AT_SIGN        &kp HASH        &kp DOLLAR            &kp PERCENT
&mt LEFT_SHIFT KP_NUMBER_0  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp PERIOD    &kp EQUAL      &trans          &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp LEFT_BRACE  &kp RIGHT_BRACE       &kp BACKSLASH
&trans                      &trans           &trans           &trans           &trans        &trans         &trans          &trans                                                                     &kp PIPE
            >;
        };

        ARROW_DEFAULT {
            bindings = <
&kp ESCAPE      &kp LC(LS(TAB))         &kp UP_ARROW    &kp LC(TAB)              &trans                       &trans  &trans  &trans  &trans  &trans
&kp HOME        &kp LEFT_ARROW          &kp DOWN_ARROW  &kp RIGHT_ARROW          &kp END  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&kp LEFT_SHIFT  &kp LG(LS(LEFT_ARROW))  &trans          &kp LG(LS(RIGHT_ARROW))  &trans   &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans          &trans                  &trans          &trans                   &trans   &trans      &trans  &trans                          &trans
            >;

            sensor-bindings = <&inc_dec_kp LC(PAGE_UP) LC(PAGE_DOWN)>;
        };

        MOUSE {
            bindings = <
&trans              &trans             &kp LC(PAGE_UP)  &kp LC(PAGE_DOWN)  &kp LC(W)                         &kp LC(W)  &kp LC(PAGE_UP)  &kp LC(PAGE_DOWN)  &trans             &trans
&lt L_SCROLL SPACE  &lt L_MOUSE SPACE  &mkp LCLK        &mkp RCLK          &mkp MCLK  &mkp RCLK      &trans  &mkp MCLK  &mkp LCLK        &mkp RCLK          &lt L_MOUSE SPACE  &lt L_SCROLL SPACE
&trans              &trans             &trans           &trans             &trans     &mkp LCLK      &trans  &trans     &mkp MB4         &mkp MB5           &trans             &trans
&trans              &trans             &trans           &trans             &trans     &trans         &trans  &trans                                                            &trans
            >;
        };

        SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&none   &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };

        FUNCTION {
            bindings = <
&kp F1   &kp F2  &kp F3  &kp F4  &kp F5                        &kp F1  &kp F2  &kp F3  &kp F4  &kp F5
&kp F6   &kp F7  &kp F8  &kp F9  &kp F10  &trans      &kp F13  &kp F6  &kp F7  &kp F8  &kp F9  &kp F10
&kp F11  &trans  &trans  &trans  &trans   &trans      &trans   &trans  &trans  &trans  &trans  &kp F11
&kp F12  &trans  &trans  &trans  &trans   &trans      &trans   &trans                          &kp F12
            >;
        };

        BT_SETTING {
            bindings = <
&to L_COFFEE         &trans        &trans        &trans        &trans                                 &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans               &trans        &trans        &trans        &trans     &trans      &studio_unlock  &trans        &trans        &trans        &trans        &trans
&trans               &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kt KP_N4  &trans      &bootloader     &trans        &trans        &trans        &trans        &bt BT_CLR
&trans               &trans        &trans        &trans        &trans     &trans      &trans          &trans                                                  &bt BT_CLR_ALL
            >;
        };

// -------------------------------------------------------------
// 🟩🟩🟩 珈琲配列 🟩🟩🟩
// -------------------------------------------------------------

        COFFEE {
            bindings = <
&to L_QWERTY   &trans  &trans  &trans  &trans                         &kp N3     &kp T   &kp X  &kp LSHFT    &kp INT3
&trans         &trans  &trans  &trans  &trans  &trans      &kp Y      &kp Q      &kp U   &kp F  &kp INT6     &kp RCTRL
&trans         &trans  &trans  &trans  &trans  &trans      &kp N0     &kp J      &kp N7  &kp O  &kp LS(DOT)  &kp RSHFT
&trans         &trans  &trans  &trans  &trans  &trans      &kp ENTER  &kp SPACE                              &none
            >;
        };

        QWERTY_RIGHT {
            bindings = <
&trans  &trans  &trans  &trans  &trans                         &kp U  &kp I  &kp O  &kp P  &kp Y
&trans  &trans  &trans  &trans  &trans  &trans      &kp H      &kp J  &kp K  &kp L  &kp BACKSPACE  &kp RCTRL
&none   &trans  &trans  &trans  &trans  &trans      &kp N      &kp M  &kp ,  &kp .  &none          &kp RSHFT
&trans  &trans  &trans  &trans  &trans  &trans      &kp ENTER  &kp SPACE                           &none
            >;
        };

        QWERTY_LEFT {
            bindings = <
&trans  &trans  &trans  &trans  &trans                         &kp R  &kp E  &kp W  &kp Q  &kp T
&trans  &trans  &trans  &trans  &trans              &kp G      &kp F  &kp D  &kp S  &kp A  &kp LCTRL
&none   &trans  &trans  &trans  &trans  &trans      &kp B      &kp V  &kp C  &kp X  &kp Z  &kp LSHFT
&trans  &trans  &trans  &trans  &trans  &trans      &kp ENTER  &kp SPACE                   &none
            >;
        };

        NUMBER {
            bindings = <
&trans  &trans  &trans  &trans  &trans                                          &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp MINUS   &none                            
&trans  &trans  &trans  &trans  &trans  &trans      &kp SLASH                   &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp PLUS    &kp ASTERISK
&trans  &trans  &trans  &trans  &trans  &trans      &mt LEFT_SHIFT KP_NUMBER_0  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp PERIOD  &kp EQUAL
&trans  &trans  &trans  &trans  &trans  &trans      &kp ENTER                   &kp SPACE                                                      &none
            >;
        };

        SIMBOL {
            bindings = <
&trans  &trans  &trans  &trans  &trans                              &kp CARET         &kp AMPERSAND      &kp TILDE       &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS
&trans  &trans  &trans  &trans  &trans  &trans      &kp UNDERSCORE  &kp EXCLAMATION   &kp AT_SIGN        &kp HASH        &kp DOLLAR            &kp PERCENT
&trans  &trans  &trans  &trans  &trans  &trans      &none           &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp LEFT_BRACE  &kp RIGHT_BRACE       &kp BACKSLASH
&trans  &trans  &trans  &trans  &trans  &trans      &kp ENTER       &kp SPACE                                                                  &kp PIPE
            >;
        };

        ARROW {
            bindings = <
&trans  &trans  &trans  &trans  &trans                              &kp ESCAPE              &kp LC(LS(TAB))  &kp UP_ARROW             &kp LC(TAB)  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &kp HOME        &kp LEFT_ARROW          &kp DOWN_ARROW   &kp RIGHT_ARROW          &kp END      &trans
&trans  &trans  &trans  &trans  &trans  &trans      &kp LEFT_SHIFT  &kp LG(LS(LEFT_ARROW))  &trans           &kp LG(LS(RIGHT_ARROW))  &trans       &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans          &trans                  &trans           &trans                   &trans       &trans
            >;

    };
};
