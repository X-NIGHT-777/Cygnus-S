#define ZMK_POINTING_DEFAULT_SCRL_VAL 120    // default: 10

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define L_QWERTY_DEFAULT           0
#define L_NUM_DEFAULT              1
#define L_ARROW_DEFAULT            2
#define L_MOUSE_DEFAULT            3
#define L_SCROLL_DEFAULT           4
#define L_FUNCTION_DEFAULT         5
#define L_BT_SETTING               6

// 珈琲配列
#define L_COFFEE                   7
#define L_QWERTY_RIGHT             8
#define L_QWERTY_LEFT              9
#define L_NUMBER                  10
#define L_SIMBOL                  11
#define L_ARROW                   12
#define L_FUNCTION                13
#define L_TRACKBALL               14 
#define L_SCROLL                  15

// マウスレイヤー
#define L_MOUSE                   16
#define L_MOUSE_SLOW              17
#define L_MOUSE_FAST              18

// カーソル速度（標準は MOVE_UP 等の 600）
#define SLOW_UP     MOVE_Y(-200)
#define SLOW_DOWN   MOVE_Y(200)
#define SLOW_LEFT   MOVE_X(-200)
#define SLOW_RIGHT  MOVE_X(200)

#define FAST_UP     MOVE_Y(-1800)
#define FAST_DOWN   MOVE_Y(1800)
#define FAST_LEFT   MOVE_X(-1800)
#define FAST_RIGHT  MOVE_X(1800)



&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

/ {



    combos {
        compatible = "zmk,combos";

    // ---- 50音 ----
    // ---- あ行 (5) ----
        combo_i {
            timeout-ms    = <50>;
            key-positions = <5 40>;             // 5 + 40 → い
            bindings      = <&kp E>;
            layers        = <L_COFFEE>;
        };
        combo_u {
            timeout-ms    = <50>;
            key-positions = <5 20>;             // 5 + 20 → う
            bindings      = <&kp N4>;
            layers        = <L_COFFEE>;
        };
        combo_e {
            timeout-ms    = <50>;
            key-positions = <5 41>;             // 5 + 41 → え
            bindings      = <&kp N5>;
            layers        = <L_COFFEE>;
        };
        combo_o {
            timeout-ms    = <50>;
            key-positions = <5 32>;             // 5 + 32 → お
            bindings      = <&kp N6>;
            layers        = <L_COFFEE>;
        };

    // ---- か行 (6) ----
        combo_ki {
            timeout-ms    = <50>;
            key-positions = <6 40>;             // 6 + 40 → き
            bindings      = <&kp G>;
            layers        = <L_COFFEE>;
        };
        combo_ku {
            timeout-ms    = <50>;
            key-positions = <6 20>;             // 6 + 20 → く
            bindings      = <&kp H>;
            layers        = <L_COFFEE>;
        };
        combo_ke {
            timeout-ms    = <50>;
            key-positions = <6 41>;             // 6 + 41 → け
            bindings      = <&kp SQT>;
            layers        = <L_COFFEE>;
        };
        combo_ko {
            timeout-ms    = <50>;
            key-positions = <6 32>;             // 6 + 32 → こ
            bindings      = <&kp B>;
            layers        = <L_COFFEE>;
        };

    // ---- さ行 (7) ----
        combo_shi {
            timeout-ms    = <50>;
            key-positions = <7 40>;             // 7 + 40 → し
            bindings      = <&kp D>;
            layers        = <L_COFFEE>;
        };
        combo_su {
            timeout-ms    = <50>;
            key-positions = <7 20>;             // 7 + 20 → す
            bindings      = <&kp R>;
            layers        = <L_COFFEE>;
        };
        combo_se {
            timeout-ms    = <50>;
            key-positions = <7 41>;             // 7 + 41 → せ
            bindings      = <&kp P>;
            layers        = <L_COFFEE>;
        };
        combo_so {
            timeout-ms    = <50>;
            key-positions = <7 32>;             // 7 + 32 → そ
            bindings      = <&kp C>;
            layers        = <L_COFFEE>;
        };

    // ---- た行 (17) ----
        combo_chi {
            timeout-ms    = <50>;
            key-positions = <17 40>;            // 17 + 40 → ち
            bindings      = <&kp A>;
            layers        = <L_COFFEE>;
        };
        combo_tsu {
            timeout-ms    = <50>;
            key-positions = <17 20>;            // 17 + 20 → つ
            bindings      = <&kp Z>;
            layers        = <L_COFFEE>;
        };
        combo_te {
            timeout-ms    = <50>;
            key-positions = <17 41>;            // 17 + 41 → て
            bindings      = <&kp W>;
            layers        = <L_COFFEE>;
        };
        combo_to {
            timeout-ms    = <50>;
            key-positions = <17 32>;            // 17 + 32 → と
            bindings      = <&kp S>;
            layers        = <L_COFFEE>;
        };

    // ---- な行 (18) ----
        combo_ni {
            timeout-ms    = <50>;
            key-positions = <18 40>;            // 18 + 40 → に
            bindings      = <&kp I>;
            layers        = <L_COFFEE>;
        };
        combo_nu {
            timeout-ms    = <50>;
            key-positions = <18 20>;            // 18 + 20 → ぬ
            bindings      = <&kp N1>;
            layers        = <L_COFFEE>;
        };
        combo_ne {
            timeout-ms    = <50>;
            key-positions = <18 41>;            // 18 + 41 → ね
            bindings      = <&kp COMMA>;
            layers        = <L_COFFEE>;
        };
        combo_no {
            timeout-ms    = <50>;
            key-positions = <18 32>;            // 18 + 32 → の
            bindings      = <&kp K>;
            layers        = <L_COFFEE>;
        };

    // ---- は行 (19) ----
        combo_hi {
            timeout-ms    = <50>;
            key-positions = <19 40>;            // 19 + 40 → ひ
            bindings      = <&kp V>;
            layers        = <L_COFFEE>;
        };
        combo_fu {
            timeout-ms    = <50>;
            key-positions = <19 20>;            // 19 + 20 → ふ
            bindings      = <&kp N2>;
            layers        = <L_COFFEE>;
        };
        combo_he {
            timeout-ms    = <50>;
            key-positions = <19 41>;            // 19 + 41 → へ
            bindings      = <&kp EQUAL>;
            layers        = <L_COFFEE>;
        };
        combo_ho {
            timeout-ms    = <50>;
            key-positions = <19 32>;            // 19 + 32 → ほ
            bindings      = <&kp MINUS>;
            layers        = <L_COFFEE>;
        };

    // ---- ま行 (29) ----
        combo_mi {
            timeout-ms    = <50>;
            key-positions = <29 40>;            // 29 + 40 → み
            bindings      = <&kp N>;
            layers        = <L_COFFEE>;
        };
        combo_mu {
            timeout-ms    = <50>;
            key-positions = <29 20>;            // 29 + 20 → む
            bindings      = <&kp NON_US_HASH>;
            layers        = <L_COFFEE>;
        };
        combo_me {
            timeout-ms    = <50>;
            key-positions = <29 41>;            // 29 + 41 → め
            bindings      = <&kp SLASH>;
            layers        = <L_COFFEE>;
        };
        combo_mo {
            timeout-ms    = <50>;
            key-positions = <29 32>;            // 29 + 32 → も
            bindings      = <&kp M>;
            layers        = <L_COFFEE>;
        };

    // ---- や行 (30) ----
        combo_yu {
            timeout-ms    = <50>;
            key-positions = <30 20>;            // 30 + 20 → ゆ
            bindings      = <&kp N8>;
            layers        = <L_COFFEE>;
        };
        combo_yo {
            timeout-ms    = <50>;
            key-positions = <30 32>;            // 30 + 32 → よ
            bindings      = <&kp N9>;
            layers        = <L_COFFEE>;
        };

    // ---- ら行 (31) ----
        combo_ri {
            timeout-ms    = <50>;
            key-positions = <31 40>;            // 31 + 40 → り
            bindings      = <&kp L>;
            layers        = <L_COFFEE>;
        };
        combo_ru {
            timeout-ms    = <50>;
            key-positions = <31 20>;            // 31 + 20 → る
            bindings      = <&kp PERIOD>;
            layers        = <L_COFFEE>;
        };
        combo_re {
            timeout-ms    = <50>;
            key-positions = <31 41>;            // 31 + 41 → れ
            bindings      = <&kp SEMICOLON>;
            layers        = <L_COFFEE>;
        };
        combo_ro {
            timeout-ms    = <50>;
            key-positions = <31 32>;            // 31 + 32 → ろ
            bindings      = <&kp INT1>;
            layers        = <L_COFFEE>;
        };

    // ---- わ行：N0 ----
        combo_wa {
            timeout-ms    = <50>;
            key-positions = <16 40>;            // 16 + 40 → わ
            bindings      = <&kp N0>;
            layers        = <L_COFFEE>;
        };
        combo_wo {
            timeout-ms    = <50>;
            key-positions = <16 41>;            // 16 + 41 → を
            bindings      = <&kp RS(N0)>;
            layers        = <L_COFFEE>;
        };

    // ---- 濁点系：BACKSPACE (28) + 清音キー [+ 母音キー] ----
    // 母音キー: 40=い段(⏎) / 20=う段(、) / 41=え段(␣) / 32=お段(。)

    // ---- が行 (6) ----
        combo_ga {
            timeout-ms    = <50>;
            key-positions = <28 6>;             // 28 + 6 → が
            bindings      = <&dkt T>;
            layers        = <L_COFFEE>;
        };
        combo_gi {
            timeout-ms    = <50>;
            key-positions = <28 6 40>;          // 28 + 6 + 40 → ぎ
            bindings      = <&dkt G>;
            layers        = <L_COFFEE>;
        };
        combo_gu {
            timeout-ms    = <50>;
            key-positions = <28 6 20>;          // 28 + 6 + 20 → ぐ
            bindings      = <&dkt H>;
            layers        = <L_COFFEE>;
        };
        combo_ge {
            timeout-ms    = <50>;
            key-positions = <28 6 41>;          // 28 + 6 + 41 → げ
            bindings      = <&dkt SQT>;
            layers        = <L_COFFEE>;
        };
        combo_go {
            timeout-ms    = <50>;
            key-positions = <28 6 32>;          // 28 + 6 + 32 → ご
            bindings      = <&dkt B>;
            layers        = <L_COFFEE>;
        };

    // ---- ざ行 (7) ----
        combo_za {
            timeout-ms    = <50>;
            key-positions = <28 7>;             // 28 + 7 → ざ
            bindings      = <&dkt X>;
            layers        = <L_COFFEE>;
        };
        combo_ji {
            timeout-ms    = <50>;
            key-positions = <28 7 40>;          // 28 + 7 + 40 → じ
            bindings      = <&dkt D>;
            layers        = <L_COFFEE>;
        };
        combo_zu {
            timeout-ms    = <50>;
            key-positions = <28 7 20>;          // 28 + 7 + 20 → ず
            bindings      = <&dkt R>;
            layers        = <L_COFFEE>;
        };
        combo_ze {
            timeout-ms    = <50>;
            key-positions = <28 7 41>;          // 28 + 7 + 41 → ぜ
            bindings      = <&dkt P>;
            layers        = <L_COFFEE>;
        };
        combo_zo {
            timeout-ms    = <50>;
            key-positions = <28 7 32>;          // 28 + 7 + 32 → ぞ
            bindings      = <&dkt C>;
            layers        = <L_COFFEE>;
        };

    // ---- だ行 (17) ----
        combo_da {
            timeout-ms    = <50>;
            key-positions = <28 17>;            // 28 + 17 → だ
            bindings      = <&dkt Q>;
            layers        = <L_COFFEE>;
        };
        combo_di {
            timeout-ms    = <50>;
            key-positions = <28 17 40>;         // 28 + 17 + 40 → ぢ
            bindings      = <&dkt A>;
            layers        = <L_COFFEE>;
        };
        combo_du {
            timeout-ms    = <50>;
            key-positions = <28 17 20>;         // 28 + 17 + 20 → づ
            bindings      = <&dkt Z>;
            layers        = <L_COFFEE>;
        };
        combo_de {
            timeout-ms    = <50>;
            key-positions = <28 17 41>;         // 28 + 17 + 41 → で
            bindings      = <&dkt W>;
            layers        = <L_COFFEE>;
        };
        combo_do {
            timeout-ms    = <50>;
            key-positions = <28 17 32>;         // 28 + 17 + 32 → ど
            bindings      = <&dkt S>;
            layers        = <L_COFFEE>;
        };

    // ---- ば行・ぱ行 (19) ※右Ctrl(sticky)を先に押すとぱ行 ----
        combo_ba {
            timeout-ms    = <50>;
            key-positions = <28 19>;            // 28 + 19 → ば / 右Ctrl待機: ぱ
            bindings      = <&mm_ba>;
            layers        = <L_COFFEE>;
        };
        combo_bi {
            timeout-ms    = <50>;
            key-positions = <28 19 40>;         // 28 + 19 + 40 → び / 右Ctrl待機: ぴ
            bindings      = <&mm_bi>;
            layers        = <L_COFFEE>;
        };
        combo_bu {
            timeout-ms    = <50>;
            key-positions = <28 19 20>;         // 28 + 19 + 20 → ぶ / 右Ctrl待機: ぷ
            bindings      = <&mm_bu>;
            layers        = <L_COFFEE>;
        };
        combo_be {
            timeout-ms    = <50>;
            key-positions = <28 19 41>;         // 28 + 19 + 41 → べ / 右Ctrl待機: ぺ
            bindings      = <&mm_be>;
            layers        = <L_COFFEE>;
        };
        combo_bo {
            timeout-ms    = <50>;
            key-positions = <28 19 32>;         // 28 + 19 + 32 → ぼ / 右Ctrl待機: ぽ
            bindings      = <&mm_bo>;
            layers        = <L_COFFEE>;
        };








    // ---- 濁点・半濁点：LSHFT (8) ----
        combo_dakuten {
            timeout-ms    = <50>;
            key-positions = <8 40>;             // 8 + 40 → ゛
            bindings      = <&kp LEFT_BRACKET>;
            layers        = <L_COFFEE>;
        };
        combo_handakuten {
            timeout-ms    = <50>;
            key-positions = <8 41>;             // 8 + 41 → ゜
            bindings      = <&kp RIGHT_BRACKET>;
            layers        = <L_COFFEE>;
        };

    // ---- 「 」：INT6 (20) ----
        combo_kagi_open {
            timeout-ms    = <50>;
            key-positions = <20 40>;            // 20 + 40 → 「
            bindings      = <&kp RS(RBKT)>;
            layers        = <L_COFFEE>;
        };
        combo_kagi_close {
            timeout-ms    = <50>;
            key-positions = <20 41>;            // 20 + 41 → 」
            bindings      = <&kp RS(NUHS)>;
            layers        = <L_COFFEE>;
        };

    // ---- （ ）：RS(DOT) (32)   🟥🟥🟥 保留中...マクロが必要な模様 🟥🟥🟥

    // ---- ！･？ = Y (16) ----
        combo_exclam {
            timeout-ms    = <50>;
            key-positions = <16 20>;            // 16 + 20 → ！
            bindings      = <&kp RS(N1)>;
            layers        = <L_COFFEE>;
        };
        combo_question {
            timeout-ms    = <50>;
            key-positions = <16 32>;            // 16 + 32 → ？   🟥🟥🟥 要確認...現状｢・」が出力 🟥🟥🟥
            bindings      = <&kp RS(FSLH)>;
            layers        = <L_COFFEE>;
        };

    // ---- ←･→･↑･↓ = BACKSPACE (28) ----
    // 右Ctrl/右Shift/右Alt(sticky)を先に押すと、behaviors側(A)のmm_*でコマンド系に切替
        combo_cursor_left {
            timeout-ms    = <50>;
            key-positions = <28 40>;            // 28 + 40 → ← (長押し: Home) / 右Ctrl待機: Ctrl+C ほか
            bindings      = <&mm_cursor_left>;
            layers        = <L_COFFEE>;
        };
        combo_cursor_right {
            timeout-ms    = <50>;
            key-positions = <28 41>;            // 28 + 41 → → (長押し: End) / 右Ctrl待機: Ctrl+V ほか
            bindings      = <&mm_cursor_right>;
            layers        = <L_COFFEE>;
        };
        combo_cursor_up {
            timeout-ms    = <50>;
            key-positions = <28 20>;            // 28 + 20 → ↑ (長押し: Ctrl+Z) / 右Ctrl待機: Ctrl+X ほか
            bindings      = <&mm_cursor_up>;
            layers        = <L_COFFEE>;
        };
        combo_cursor_down {
            timeout-ms    = <50>;
            key-positions = <28 32>;            // 28 + 32 → ↓ (長押し: Ctrl+A) / 右Ctrl待機: Win+V ほか
            bindings      = <&mm_cursor_down>;
            layers        = <L_COFFEE>;
        };

    };



    macros {
    // 濁点: 渡したキー + ゛(LEFT_BRACKET)
        dkt: dkt {
            compatible = "zmk,behavior-macro-one-param";
            label = "DKT";
            #binding-cells = <1>;
            wait-ms = <10>;
            tap-ms  = <10>;
            bindings = <&macro_param_1to1>, <&macro_tap &kp MACRO_PLACEHOLDER &kp LEFT_BRACKET>;
        };

    // 半濁点: 渡したキー + ゜(RIGHT_BRACKET)
        hdk: hdk {
            compatible = "zmk,behavior-macro-one-param";
            label = "HDK";
            #binding-cells = <1>;
            wait-ms = <10>;
            tap-ms  = <10>;
            bindings = <&macro_param_1to1>, <&macro_tap &kp MACRO_PLACEHOLDER &kp RIGHT_BRACKET>;
        };

    };



    behaviors {

        ROTATE: ROTATE {
            compatible = "zmk,behavior-sensor-rotate-var";
            label = "ROTATE";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;

            tap-ms = <20>;
        };

    // タップ=キー、ホールド=別キー（コンボ用。タップ優先＝重なり打ちでホールドに誤判定しない）
        ht_kp: hold_tap_kp {
            compatible = "zmk,behavior-hold-tap";
            label = "HOLD_TAP_KP";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <250>;
            bindings = <&kp>, <&kp>;        // 1番目=ホールド、2番目=タップ
        };

    // タップ=キー、ホールド=レイヤーへ移動（離しても滞在）
        ht_to: hold_tap_to {
            compatible = "zmk,behavior-hold-tap";
            label = "HOLD_TAP_TO";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&to>, <&kp>;        // 1番目=ホールド、2番目=タップ
        };

    // ======================================================================
    // A. combo(28+各キー)用: 右Ctrl/右Shift/右Alt(sticky)待機中にコマンド系へ切替
    //    判定順: 右Ctrl待機 → コピペ系 / 右Shift待機 → ウィンドウ操作系 / 右Alt待機 → Ctrl+F / なし → カーソル系
    //    命名: 外側(comboから呼ぶ入口)=機能名 mm_cursor_* / 内側=判定する修飾キー mm_rs_*(右Shift)・mm_ra_*(右Alt)
    // ======================================================================

    // ---- 外側(入口): 右Ctrl待機中ならコピペ系、それ以外は内側1(右Shift判定)へ ----
        mm_cursor_left: mm_cursor_left {
            compatible = "zmk,behavior-mod-morph";
            label = "MM_CURSOR_LEFT";
            #binding-cells = <0>;
            bindings = <&mm_rs_left>, <&kp C>;              // 40: 右Ctrl待機=Ctrl+C / それ以外は内側へ
            mods = <(MOD_RCTL)>;
            keep-mods = <(MOD_RCTL)>;                       // 右Ctrlを残す
        };

        mm_cursor_right: mm_cursor_right {
            compatible = "zmk,behavior-mod-morph";
            label = "MM_CURSOR_RIGHT";
            #binding-cells = <0>;
            bindings = <&mm_rs_right>, <&kp V>;             // 41: 右Ctrl待機=Ctrl+V / それ以外は内側へ
            mods = <(MOD_RCTL)>;
            keep-mods = <(MOD_RCTL)>;
        };

        mm_cursor_up: mm_cursor_up {
            compatible = "zmk,behavior-mod-morph";
            label = "MM_CURSOR_UP";
            #binding-cells = <0>;
            bindings = <&mm_rs_up>, <&kp X>;                // 20: 右Ctrl待機=Ctrl+X / それ以外は内側へ
            mods = <(MOD_RCTL)>;
            keep-mods = <(MOD_RCTL)>;
        };

        mm_cursor_down: mm_cursor_down {
            compatible = "zmk,behavior-mod-morph";
            label = "MM_CURSOR_DOWN";
            #binding-cells = <0>;
            bindings = <&mm_rs_down>, <&kp RG(V)>;          // 32: 右Ctrl待機=Win+V / それ以外は内側へ
            mods = <(MOD_RCTL)>;                            // keep-modsなし → 右Ctrlを外してWin+Vだけ出す
        };

    // ---- 内側1(RS): 右Shift待機中ならウィンドウ操作系、なければ内側2(右Alt判定)へ ----
        mm_rs_left: mm_rs_left {
            compatible = "zmk,behavior-mod-morph";
            label = "MM_RS_LEFT";
            #binding-cells = <0>;
            bindings = <&mm_ra_left>, <&kp RC(RS(TAB))>;    // 40: 右Shift待機=Ctrl+Shift+Tab / それ以外は内側2へ
            mods = <(MOD_RSFT)>;                            // keep-modsなし → 右Shiftを外して明示指定を出す
        };

        mm_rs_right: mm_rs_right {
            compatible = "zmk,behavior-mod-morph";
            label = "MM_RS_RIGHT";
            #binding-cells = <0>;
            bindings = <&mm_ra_right>, <&kp RC(TAB)>;       // 41: 右Shift待機=Ctrl+Tab / それ以外は内側2へ
            mods = <(MOD_RSFT)>;
        };

        mm_rs_up: mm_rs_up {
            compatible = "zmk,behavior-mod-morph";
            label = "MM_RS_UP";
            #binding-cells = <0>;
            bindings = <&mm_ra_up>, <&kp RG(TAB)>;          // 20: 右Shift待機=Win+Tab / それ以外は内側2へ
            mods = <(MOD_RSFT)>;
        };

        mm_rs_down: mm_rs_down {
            compatible = "zmk,behavior-mod-morph";
            label = "MM_RS_DOWN";
            #binding-cells = <0>;
            bindings = <&mm_ra_down>, <&kp RG(D)>;          // 32: 右Shift待機=Win+D / それ以外は内側2へ
            mods = <(MOD_RSFT)>;
        };

    // ---- 内側2(RA): 右Alt待機中ならCtrl+F、なければカーソル系 ----
        mm_ra_left: mm_ra_left {
            compatible = "zmk,behavior-mod-morph";
            label = "MM_RA_LEFT";
            #binding-cells = <0>;
            bindings = <&mt HOME LEFT>, <&kp RC(F)>;        // 40: ← (長押しHome) / 🟦暫定 Ctrl+F 出力
            mods = <(MOD_RALT)>;                            // keep-modsなし → 右Altを外してCtrl+Fだけ出す
        };

        mm_ra_right: mm_ra_right {
            compatible = "zmk,behavior-mod-morph";
            label = "MM_RA_RIGHT";
            #binding-cells = <0>;
            bindings = <&mt END RIGHT>, <&kp RC(F)>;        // 41: → (長押しEnd) / 🟦暫定 Ctrl+F 出力
            mods = <(MOD_RALT)>;
        };

        mm_ra_up: mm_ra_up {
            compatible = "zmk,behavior-mod-morph";
            label = "MM_RA_UP";
            #binding-cells = <0>;
            bindings = <&mt RC(Z) UP>, <&kp RC(F)>;         // 20: ↑ (長押しCtrl+Z) / 🟦暫定 Ctrl+F 出力
            mods = <(MOD_RALT)>;
        };

        mm_ra_down: mm_ra_down {
            compatible = "zmk,behavior-mod-morph";
            label = "MM_RA_DOWN";
            #binding-cells = <0>;
            bindings = <&mt RC(A) DOWN>, <&kp RC(F)>;       // 32: ↓ (長押しCtrl+A) / 🟦暫定 Ctrl+F 出力
            mods = <(MOD_RALT)>;
        };

    // ======================================================================
    // B. 単独キー(28・40・41番)用: 右Ctrl/右Shift/右Alt(sticky)待機中に出力を切替
    //    命名: 入口(キーマップから呼ぶ)=機能名 mm_bs・mm_enter・mm_space / 内側=判定する修飾キー
    // ======================================================================

    // ---- 28番: 右Ctrl待機=Tab / 右Shift・右Alt待機=Ctrl+F / それ以外はBackspace ----
        mm_bs: mm_bs {
            compatible = "zmk,behavior-mod-morph";
            label = "MM_BS";
            #binding-cells = <0>;
            bindings = <&mm_bs_in>, <&kp TAB>;              // 28: 右Ctrl待機=Tab / それ以外は内側へ
            mods = <(MOD_RCTL)>;                            // keep-modsなし → 右Ctrlを外してTabだけ出す
        };

        mm_bs_in: mm_bs_in {
            compatible = "zmk,behavior-mod-morph";
            label = "MM_BS_IN";
            #binding-cells = <0>;
            bindings = <&kp BACKSPACE>, <&kp RC(F)>;        // 28: BS / 🟦暫定 右Shift・右Alt待機=Ctrl+F
            mods = <(MOD_RSFT|MOD_RALT)>;
        };

    // ---- 40番: 右Ctrl待機=ESC / 右Shift待機=Ctrl+F / 右Alt待機=F8 / それ以外はEnter(長押しNUMBER) ----
        mm_enter: mm_enter {
            compatible = "zmk,behavior-mod-morph";
            label = "MM_ENTER";
            #binding-cells = <0>;
            bindings = <&mm_enter_rs>, <&kp ESC>;           // 40: 右Ctrl待機=ESC / それ以外は内側1へ
            mods = <(MOD_RCTL)>;
        };

        mm_enter_rs: mm_enter_rs {
            compatible = "zmk,behavior-mod-morph";
            label = "MM_ENTER_RS";
            #binding-cells = <0>;
            bindings = <&mm_enter_ra>, <&kp RC(F)>;         // 40: 右Shift待機=🟦暫定 Ctrl+F / それ以外は内側2へ
            mods = <(MOD_RSFT)>;
        };

        mm_enter_ra: mm_enter_ra {
            compatible = "zmk,behavior-mod-morph";
            label = "MM_ENTER_RA";
            #binding-cells = <0>;
            bindings = <&ht_to L_NUMBER ENTER>, <&kp F8>;   // 40: Enter(長押しNUMBER) / 右Alt待機=F8
            mods = <(MOD_RALT)>;
        };

    // ======================================================================
    // C. combo(28+は行)用: 右Ctrl(sticky)待機中は半濁点(ぱ行)、なければ濁点(ば行)
    // ======================================================================
        mm_ba: mm_ba {
            compatible = "zmk,behavior-mod-morph";
            label = "MM_BA";
            #binding-cells = <0>;
            bindings = <&dkt F>, <&hdk F>;                  // は: ば / 右Ctrl待機=ぱ
            mods = <(MOD_RCTL)>;                            // keep-modsなし → 右Ctrlを外して出力
        };

        mm_bi: mm_bi {
            compatible = "zmk,behavior-mod-morph";
            label = "MM_BI";
            #binding-cells = <0>;
            bindings = <&dkt V>, <&hdk V>;                  // ひ: び / 右Ctrl待機=ぴ
            mods = <(MOD_RCTL)>;
        };

        mm_bu: mm_bu {
            compatible = "zmk,behavior-mod-morph";
            label = "MM_BU";
            #binding-cells = <0>;
            bindings = <&dkt N2>, <&hdk N2>;                // ふ: ぶ / 右Ctrl待機=ぷ
            mods = <(MOD_RCTL)>;
        };

        mm_be: mm_be {
            compatible = "zmk,behavior-mod-morph";
            label = "MM_BE";
            #binding-cells = <0>;
            bindings = <&dkt EQUAL>, <&hdk EQUAL>;          // へ: べ / 右Ctrl待機=ぺ
            mods = <(MOD_RCTL)>;
        };

        mm_bo: mm_bo {
            compatible = "zmk,behavior-mod-morph";
            label = "MM_BO";
            #binding-cells = <0>;
            bindings = <&dkt MINUS>, <&hdk MINUS>;          // ほ: ぼ / 右Ctrl待機=ぽ
            mods = <(MOD_RCTL)>;
        };

    // ---- 41番: 右Ctrl・右Shift・右Alt待機=Ctrl+F / それ以外はSpace(長押しQWERTY_RIGHT) ----
        mm_space: mm_space {
            compatible = "zmk,behavior-mod-morph";
            label = "MM_SPACE";
            #binding-cells = <0>;
            bindings = <&ht_to L_QWERTY_RIGHT SPACE>, <&kp RC(F)>;  // 41: Space(長押しQWERTY_RIGHT) / 🟦暫定 待機中=Ctrl+F
            mods = <(MOD_RCTL|MOD_RSFT|MOD_RALT)>;
        };

    };



    keymap {
        compatible = "zmk,keymap";

        QWERTY_DEFAULT {
            bindings = <
&kp Q             &kp W         &kp E         &kp R                  &kp T                                                                       &kp Y                    &kp U  &kp I      &kp O                  &kp P
&kp A             &kp S         &kp D         &kp F                  &kp G                         &mkp RCLK                     &kp UP_ARROW    &kp H                    &kp J  &kp K      &lt L_MOUSE_DEFAULT L  &lt L_SCROLL_DEFAULT MINUS
&mt LEFT_SHIFT Z  &kp X         &kp C         &kp V                  &kp B                         &mkp LCLK                     &kp DOWN_ARROW  &kp N                    &kp M  &kp COMMA  &kp DOT                &mt LEFT_SHIFT SLASH
&kp LCTRL         &kp LEFT_WIN  &kp LEFT_ALT  &lt L_BT_SETTING INT4  &lt L_FUNCTION_DEFAULT SPACE  &lt L_ARROW_DEFAULT INT5      &kp BACKSPACE   &lt L_NUM_DEFAULT ENTER                                           &kp DEL
            >;

            sensor-bindings = <&ROTATE SCRL_DOWN SCRL_UP>;
        };

        NUM_DEFAULT {
            bindings = <
&kp MINUS                   &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp PLUS                                     &kp CARET         &kp AMPERSAND      &kp TILDE       &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS
&kp SLASH                   &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp ASTERISK  &trans         &kp UNDERSCORE  &kp EXCLAMATION   &kp AT_SIGN        &kp HASH        &kp DOLLAR            &kp PERCENT
&mt LEFT_SHIFT KP_NUMBER_0  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp PERIOD    &kp EQUAL      &trans          &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp LEFT_BRACE  &kp RIGHT_BRACE       &kp BACKSLASH
&trans                      &trans           &trans           &trans           &trans        &trans         &trans          &trans                                                                     &kp PIPE
            >;
        };

        ARROW_DEFAULT {
            bindings = <
&kp ESCAPE      &kp LC(LS(TAB))         &kp UP_ARROW    &kp LC(TAB)              &trans                       &trans  &trans  &trans  &trans  &trans
&kp HOME        &kp LEFT_ARROW          &kp DOWN_ARROW  &kp RIGHT_ARROW          &kp END  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&kp LEFT_SHIFT  &kp LG(LS(LEFT_ARROW))  &trans          &kp LG(LS(RIGHT_ARROW))  &trans   &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans          &trans                  &trans          &trans                   &trans   &trans      &trans  &trans                          &trans
            >;

            sensor-bindings = <&inc_dec_kp LC(PAGE_UP) LC(PAGE_DOWN)>;
        };

        MOUSE_DEFAULT {
            bindings = <
&trans                      &trans                     &kp LC(PAGE_UP)  &kp LC(PAGE_DOWN)  &kp LC(W)                         &kp LC(W)  &kp LC(PAGE_UP)  &kp LC(PAGE_DOWN)  &trans                     &trans
&lt L_SCROLL_DEFAULT SPACE  &lt L_MOUSE_DEFAULT SPACE  &mkp LCLK        &mkp RCLK          &mkp MCLK  &mkp RCLK      &trans  &mkp MCLK  &mkp LCLK        &mkp RCLK          &lt L_MOUSE_DEFAULT SPACE  &lt L_SCROLL_DEFAULT SPACE
&trans                      &trans                     &trans           &trans             &trans     &mkp LCLK      &trans  &trans     &mkp MB4         &mkp MB5           &trans                     &trans
&trans                      &trans                     &trans           &trans             &trans     &trans         &trans  &trans                                                                    &trans
            >;
        };

        SCROLL_DEFAULT {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&none   &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };

        FUNCTION_DEFAULT {
            bindings = <
&kp F1   &kp F2  &kp F3  &kp F4  &kp F5                        &kp F1  &kp F2  &kp F3  &kp F4  &kp F5
&kp F6   &kp F7  &kp F8  &kp F9  &kp F10  &trans      &kp F13  &kp F6  &kp F7  &kp F8  &kp F9  &kp F10
&kp F11  &trans  &trans  &trans  &trans   &trans      &trans   &trans  &trans  &trans  &trans  &kp F11
&kp F12  &trans  &trans  &trans  &trans   &trans      &trans   &trans                          &kp F12
            >;
        };

        BT_SETTING {
            bindings = <
&to L_COFFEE         &trans        &trans        &trans        &trans                                 &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans               &trans        &trans        &trans        &trans        &trans      &studio_unlock  &trans        &trans        &trans        &trans        &trans
&trans               &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &trans      &bootloader     &trans        &trans        &trans        &trans        &bt BT_CLR
&trans               &trans        &trans        &trans        &trans        &trans      &trans          &trans                                                  &bt BT_CLR_ALL
            >;
        };

// -------------------------------------------------------------
// 🟩🟩🟩 珈琲配列 🟩🟩🟩
// -------------------------------------------------------------

        COFFEE {
            bindings = <
&to L_QWERTY_DEFAULT  &trans  &trans  &trans  &trans                         &kp N3     &kp T   &kp X  &kp LSHFT    &kp INT3
&trans                &trans  &trans  &trans  &trans  &trans      &kp Y      &kp Q      &kp U   &kp F  &kp INT6     &sk RCTRL
&trans                &trans  &trans  &trans  &trans  &trans      &mm_bs     &kp J      &kp N7  &kp O  &kp RS(DOT)  &sk RSHFT
&to L_MOUSE           &trans  &trans  &trans  &trans  &trans      &mm_enter  &mm_space                              &sk RALT
            >;
        };

        QWERTY_RIGHT {
            bindings = <
&trans  &trans  &trans  &trans  &trans                         &kp U      &kp I      &kp O       &kp P          &kp Y
&trans  &trans  &trans  &trans  &trans  &trans      &kp H      &kp J      &kp K      &kp L       &kp BACKSPACE  &kp RCTRL
&none   &trans  &trans  &trans  &trans  &trans      &kp N      &kp M      &kp COMMA  &kp PERIOD  &none          &kp RSHFT
&trans  &trans  &trans  &trans  &trans  &trans      &kp ENTER  &kp SPACE                                        &to L_COFFEE
            >;
        };

        QWERTY_LEFT {
            bindings = <
&trans  &trans  &trans  &trans  &trans                         &kp R      &kp E  &kp W  &kp Q  &kp T
&trans  &trans  &trans  &trans  &trans  &trans      &kp G      &kp F      &kp D  &kp S  &kp A  &kp RCTRL
&none   &trans  &trans  &trans  &trans  &trans      &kp B      &kp V      &kp C  &kp X  &kp Z  &kp RSHFT
&trans  &trans  &trans  &trans  &trans  &trans      &kp ENTER  &kp SPACE                       &to L_COFFEE
            >;
        };

        NUMBER {
            bindings = <
&trans  &trans  &trans  &trans  &trans                               &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp MINUS   &kp SLASH                            
&trans  &trans  &trans  &trans  &trans  &trans      &to L_SIMBOL     &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp PLUS    &kp ASTERISK
&trans  &trans  &trans  &trans  &trans  &trans      &kp KP_NUMBER_0  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp PERIOD  &kp EQUAL
&trans  &trans  &trans  &trans  &trans  &trans      &kp ENTER        &kp SPACE                                                      &to L_COFFEE
            >;
        };

        SIMBOL {
            bindings = <
&trans  &trans  &trans  &trans  &trans                           &kp CARET         &kp AMPERSAND      &kp TILDE       &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS
&trans  &trans  &trans  &trans  &trans  &trans      &to L_NUMBER &kp EXCLAMATION   &kp AT_SIGN        &kp HASH        &kp DOLLAR            &kp PERCENT
&trans  &trans  &trans  &trans  &trans  &trans      &kp PIPE     &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp LEFT_BRACE  &kp RIGHT_BRACE       &kp UNDERSCORE
&trans  &trans  &trans  &trans  &trans  &trans      &kp ENTER    &kp SPACE                                                                  &to L_COFFEE
            >;
        };

        ARROW {
            bindings = <
&trans  &trans  &trans  &trans  &trans                              &kp LC(LS(TAB))         &kp UP_ARROW     &kp LC(TAB)              &kp ESCAPE   &trans
&trans  &trans  &trans  &trans  &trans  &trans      &kp HOME        &kp LEFT_ARROW          &kp DOWN_ARROW   &kp RIGHT_ARROW          &kp END      &trans
&trans  &trans  &trans  &trans  &trans  &trans      &kp LEFT_SHIFT  &kp LG(LS(LEFT_ARROW))  &trans           &kp LG(LS(RIGHT_ARROW))  &trans       &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans          &trans                                                                         &to L_COFFEE
            >;
        };

        FUNCTION {    // 🟥🟥🟥 未配置 🟥🟥🟥
            bindings = <
&kp F1   &kp F2  &kp F3  &kp F4  &kp F5                        &kp F1  &kp F2  &kp F3  &kp F4  &kp F5
&kp F6   &kp F7  &kp F8  &kp F9  &kp F10  &trans      &kp F13  &kp F6  &kp F7  &kp F8  &kp F9  &kp F10
&kp F11  &trans  &trans  &trans  &trans   &trans      &trans   &trans  &trans  &trans  &trans  &kp F11
&kp F12  &trans  &trans  &trans  &trans   &trans      &trans   &trans                          &kp F12
            >;
        };

        TRACKBALL {   // 🟥🟥🟥 未配置 🟥🟥🟥
            bindings = <
&trans              &trans     &kp LC(PAGE_UP)  &kp LC(PAGE_DOWN)  &kp LC(W)                                 &kp LC(LS(TAB))  &trans     &kp LC(TAB)  &trans        &trans 
&lt L_SCROLL SPACE  &kp SPACE  &mkp LCLK        &mkp RCLK          &mkp MCLK  &mkp RCLK      &msc SCRL_UP    &mkp LCLK        &mkp MCLK  &mkp RCLK    &mo L_SCROLL  &trans
&trans              &trans     &trans           &trans             &trans     &mkp LCLK      &msc SCRL_DOWN  &mkp MB4         &mkp MB5   &kp LC(W)    &trans        &trans
&trans              &trans     &trans           &trans             &trans     &trans         &trans          &trans                                                 &trans
            >;
        };

        SCROLL {      // 🟥🟥🟥 未配置 🟥🟥🟥
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&none   &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };

        MOUSE {
            bindings = <
&trans  &trans  &trans  &trans  &trans                         &kp LC(LS(TAB))  &mmv MOVE_UP    &kp LC(TAB)      &msc SCRL_LEFT    &msc SCRL_RIGHT
&trans  &trans  &trans  &trans  &trans  &trans      &trans     &mmv MOVE_LEFT   &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &mo L_MOUSE_FAST  &msc SCRL_UP
&none   &trans  &trans  &trans  &trans  &trans      &mkp MCLK  &mkp MB4         &mkp MB5        &trans           &mo L_MOUSE_SLOW  &msc SCRL_DOWN
&trans  &trans  &trans  &trans  &trans  &trans      &mkp RCLK                   &mkp LCLK                                          &to L_COFFEE
            >;
        };

        MOUSE_SLOW {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans          &mmv SLOW_UP    &trans           &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &mmv SLOW_LEFT  &mmv SLOW_DOWN  &mmv SLOW_RIGHT  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans          &trans          &trans           &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                                           &trans
            >;
        };

        MOUSE_FAST {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans          &mmv FAST_UP    &trans           &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &mmv FAST_LEFT  &mmv FAST_DOWN  &mmv FAST_RIGHT  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans          &trans          &trans           &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                                                   &trans
            >;
        };

    };
};
