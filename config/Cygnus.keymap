#define ZMK_POINTING_DEFAULT_SCRL_VAL 120    // default: 10

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define L_QWERTY                   0
#define L_NUM                      1
#define L_ARROW                    2
#define L_MOUSE                    3
#define L_SCROLL                   4
#define L_FUNCTION                 5
#define L_BT_SETTING               6
#define L_COFFEE_BASE              7 // 子音
#define L_COFFEE_VOWEL             8 // 子音を押している間の母音面
#define L_COFFEE_VOWEL_SP          9 // Space長押しで入る母音面(L/Q/V/C/X/F入り)
#define L_GRP_U                   10 // 母音uグループ用
#define L_GRP_O                   11 // 母音oグループ用
#define L_GRP_A                   12 // 母音aグループ用
#define L_GRP_I                   13 // 母音iグループ用
#define L_GRP_E                   14 // 母音eグループ用
#define L_GRP_NONE L_COFFEE_VOWEL    // 逆押し母音なし(母音面のみ)

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

/ {
    combos {
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };

        cons: cons {
            compatible = "zmk,behavior-macro-two-param";
            label = "CONS";
            #binding-cells = <2>;                // 引数1=子音キー, 引数2=母音グループ用レイヤー
            wait-ms = <0>;                       // 実機で調整
            tap-ms = <5>;                        // 実機で調整
            bindings =
                <&macro_press>,
                <&mo L_COFFEE_VOWEL &macro_param_2to1>,
                <&macro_press>,
                <&mo MACRO_PLACEHOLDER &macro_param_1to1>,
                <&macro_tap>,
                <&kp MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&mo L_COFFEE_VOWEL &macro_param_2to1>,
                <&macro_release>,
                <&mo MACRO_PLACEHOLDER>;
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        ROTATE: ROTATE {
            compatible = "zmk,behavior-sensor-rotate-var";
            label = "ROTATE";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;

            tap-ms = <20>;
        };

        lt_spc: lt_spc {
            compatible = "zmk,behavior-hold-tap";
            label = "LT_SPC";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            bindings = <&mo>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        QWERTY {
            bindings = <
&kp Q             &kp W         &kp E         &kp R                             &kp T                                                                  &kp Y        &kp U  &kp I      &kp O          &kp P
&kp A             &kp S         &kp D         &kp F                             &kp G                 &mkp RCLK                        &kp UP_ARROW    &kp H        &kp J  &kp K      &lt L_MOUSE L  &lt L_SCROLL MINUS
&mt LEFT_SHIFT Z  &kp X         &kp C         &kp V                             &kp B                 &mkp LCLK                        &kp DOWN_ARROW  &kp N        &kp M  &kp COMMA  &kp DOT        &mt LEFT_SHIFT SLASH
&kp LCTRL         &kp LEFT_WIN  &kp LEFT_ALT  &lt L_BT_SETTING INTERNATIONAL_4  &lt L_FUNCTION SPACE  &lt L_ARROW INTERNATIONAL_5      &kp BACKSPACE   &lt L_NUM ENTER                               &kp DEL
            >;

            sensor-bindings = <&ROTATE SCRL_DOWN SCRL_UP>;
        };

        NUM {
            bindings = <
&kp MINUS                   &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp PLUS                                     &kp CARET         &kp AMPERSAND      &kp TILDE       &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS
&kp SLASH                   &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp ASTERISK  &trans         &kp UNDERSCORE  &kp EXCLAMATION   &kp AT_SIGN        &kp HASH        &kp DOLLAR            &kp PERCENT
&mt LEFT_SHIFT KP_NUMBER_0  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp PERIOD    &kp EQUAL      &trans          &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp LEFT_BRACE  &kp RIGHT_BRACE       &kp BACKSLASH
&trans                      &trans           &trans           &trans           &trans        &trans         &trans          &trans                                                                     &kp PIPE
            >;
        };

        ARROW {
            bindings = <
&kp ESCAPE      &kp LC(LS(TAB))         &kp UP_ARROW    &kp LC(TAB)              &trans                       &trans  &trans  &trans  &trans  &trans
&kp HOME        &kp LEFT_ARROW          &kp DOWN_ARROW  &kp RIGHT_ARROW          &kp END  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&kp LEFT_SHIFT  &kp LG(LS(LEFT_ARROW))  &trans          &kp LG(LS(RIGHT_ARROW))  &trans   &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans          &trans                  &trans          &trans                   &trans   &trans      &trans  &trans                          &trans
            >;

            sensor-bindings = <&inc_dec_kp LC(PAGE_UP) LC(PAGE_DOWN)>;
        };

        MOUSE {
            bindings = <
&trans              &trans             &kp LC(PAGE_UP)  &kp LC(PAGE_DOWN)  &kp LC(W)                         &kp LC(W)  &kp LC(PAGE_UP)  &kp LC(PAGE_DOWN)  &trans             &trans
&lt L_SCROLL SPACE  &lt L_MOUSE SPACE  &mkp LCLK        &mkp RCLK          &mkp MCLK  &mkp RCLK      &trans  &mkp MCLK  &mkp LCLK        &mkp RCLK          &lt L_MOUSE SPACE  &lt L_SCROLL SPACE
&trans              &trans             &trans           &trans             &trans     &mkp LCLK      &trans  &trans     &mkp MB4         &mkp MB5           &trans             &trans
&trans              &trans             &trans           &trans             &trans     &trans         &trans  &trans                                                            &trans
            >;
        };

        SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&none   &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };

        FUNCTION {
            bindings = <
&kp F1   &kp F2  &kp F3  &kp F4  &kp F5                        &kp F1  &kp F2  &kp F3  &kp F4  &kp F5
&kp F6   &kp F7  &kp F8  &kp F9  &kp F10  &trans      &kp F13  &kp F6  &kp F7  &kp F8  &kp F9  &kp F10
&kp F11  &trans  &trans  &trans  &trans   &trans      &trans   &trans  &trans  &trans  &trans  &kp F11
&kp F12  &trans  &trans  &trans  &trans   &trans      &trans   &trans                          &kp F12
            >;
        };

        BT_SETTING {
            bindings = <
&to L_COFFEE_BASE    &trans        &trans        &trans        &trans                                 &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans               &trans        &trans        &trans        &trans     &trans      &studio_unlock  &trans        &trans        &trans        &trans        &trans
&trans               &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kt KP_N4  &trans      &bootloader     &trans        &trans        &trans        &trans        &bt BT_CLR
&trans               &trans        &trans        &trans        &trans     &trans      &trans          &trans                                                  &bt BT_CLR_ALL
            >;
        };

// -------------------------------------------------------------
// 🟩🟩🟩 珈琲配列 🟩🟩🟩
// -------------------------------------------------------------

        COFFEE_BASE {
            bindings = <
&to L_QWERTY  &trans  &trans  &trans  &trans                                  &cons W L_GRP_NONE               &cons R L_GRP_U     &cons Y L_GRP_NONE  &cons M L_GRP_NONE  &cons P L_GRP_NONE
&trans        &trans  &trans  &trans  &trans  &trans      &cons H L_GRP_NONE  &cons N L_GRP_O                  &cons T L_GRP_A     &cons S L_GRP_I     &cons K L_GRP_E     &kp RCTRL
&trans        &trans  &trans  &trans  &trans  &trans      &cons J L_GRP_NONE  &cons G L_GRP_NONE               &cons B L_GRP_NONE  &cons D L_GRP_NONE  &cons Z L_GRP_NONE  &kp RSHFT
&trans        &trans  &trans  &trans  &trans  &trans      &kp ENTER           &lt_spc L_COFFEE_VOWEL_SP SPACE                                                              &none
            >;
        };

        COFFEE_VOWEL {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &kp U   &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &kp O   &kp A   &kp I   &kp E   &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };

        COFFEE_VOWEL_SP {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &kp U  &kp L   &kp Q  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &kp O   &kp A  &kp I   &kp E   &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &kp V   &kp C  &kp X   &kp F   &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                         &trans
            >;
        };

        GRP_U {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &kp U                           &trans
            >;
        };

        GRP_O {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &kp O                           &trans
            >;
        };

        GRP_A {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &kp A                           &trans
            >;
        };

        GRP_I {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &kp I                           &trans
            >;
        };

        GRP_E {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &kp E                           &trans
            >;
        };

        KEYBOARD_MOUSE {
            bindings = <
&trans  &trans  &trans  &trans  &trans                        &none          &mmv MOVE_UP    &none            &none   &trans
&trans  &trans  &trans  &trans  &trans  &trans      &none     &mmv MOVE_LEFT &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &none   &trans
&trans  &trans  &trans  &trans  &trans  &trans      &none     &mkp LCLK      &mkp MCLK       &mkp RCLK        &none   &trans
&trans  &trans  &trans  &trans  &trans  &trans      &mo FAST  &mo PRECISION                                                  &trans
            >;
        };

    };
};
