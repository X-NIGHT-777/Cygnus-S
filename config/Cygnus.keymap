#define ZMK_POINTING_DEFAULT_SCRL_VAL 120    // default: 10

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define MOUSE 4
#define SCROLL 5
#define NUM 6
#define COFFEE_BASE 7
#define COFFEE_VOWEL 8

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

/ {



    macros {
        // --- レイヤー切替用マクロ（Cygnus既存機能） ---
        // 引数で受け取ったキーコードを入力しつつレイヤー0に戻る動作

        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };

        // =============================================================
        // 珈琲配列：子音＋母音の2文字一括送出マクロ定義
        // 同時押し・逆順打鍵時にPC側で「あ」等へ誤変換されるのを防ぐため
        // 子音と母音の2キーコードを一括送信するマクロ
        // =============================================================

