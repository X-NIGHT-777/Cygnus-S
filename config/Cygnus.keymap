#define ZMK_POINTING_DEFAULT_SCRL_VAL 120    // default: 10

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define MOUSE 4
#define SCROLL 5
#define NUM 6
#define COFFEE_BASE 7
#define COFFEE_VOWEL 8

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

/ {



    macros {
        // --- レイヤー切替用マクロ（Cygnus既存機能） ---
        // 引数で受け取ったキーコードを入力しつつレイヤー0に戻る動作

        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };

        // =============================================================
        // 風神配列：子音＋母音の2文字一括送出マクロ定義
        // 同時押し・逆順打鍵時にPC側で「あ」等へ誤変換されるのを防ぐため
        // 子音と母音の2キーコードを一括送信するマクロ
        // =============================================================

        // --- か行 ---

        // K + A (か)
        macro_ka: macro_ka {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp K &kp A>;
            label = "MACRO_KA";
        }; // か

        // K + I (き)
        macro_ki: macro_ki {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp K &kp I>;
            label = "MACRO_KI";
        }; // き

        // K + U (く)
        macro_ku: macro_ku {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp K &kp U>;
            label = "MACRO_KU";
        }; // く

        // K + E (け)
        macro_ke: macro_ke {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp K &kp E>;
            label = "MACRO_KE";
        }; // け

        // K + O (こ)
        macro_ko: macro_ko {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp K &kp O>;
            label = "MACRO_KO";
        }; // こ

        // --- さ行 ---

        // S + A (さ)
        macro_sa: macro_sa {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp S &kp A>;
            label = "MACRO_SA";
        }; // さ

        // S + I (し)
        macro_si: macro_si {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp S &kp I>;
            label = "MACRO_SI";
        }; // し

        // S + U (す)
        macro_su: macro_su {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp S &kp U>;
            label = "MACRO_SU";
        }; // す

        // S + E (せ)
        macro_se: macro_se {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp S &kp E>;
            label = "MACRO_SE";
        }; // せ

        // S + O (そ)
        macro_so: macro_so {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp S &kp O>;
            label = "MACRO_SO";
        }; // そ

        // --- た行 ---

        // T + A (た)
        macro_ta: macro_ta {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp T &kp A>;
            label = "MACRO_TA";
        }; // た

        // T + I (ち)
        macro_ti: macro_ti {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp T &kp I>;
            label = "MACRO_TI";
        }; // ち

        // T + U (つ)
        macro_tu: macro_tu {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp T &kp U>;
            label = "MACRO_TU";
        }; // つ

        // T + E (て)
        macro_te: macro_te {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp T &kp E>;
            label = "MACRO_TE";
        }; // て

        // T + O (と)
        macro_to: macro_to {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp T &kp O>;
            label = "MACRO_TO";
        }; // と

        // --- な行 ---

        // N + A (な)
        macro_na: macro_na {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp N &kp A>;
            label = "MACRO_NA";
        }; // な

        // N + I (に)
        macro_ni: macro_ni {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp N &kp I>;
            label = "MACRO_NI";
        }; // に

        // N + U (ぬ)
        macro_nu: macro_nu {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp N &kp U>;
            label = "MACRO_NU";
        }; // ぬ

        // N + E (ね)
        macro_ne: macro_ne {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp N &kp E>;
            label = "MACRO_NE";
        }; // ね

        // N + O (の)
        macro_no: macro_no {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp N &kp O>;
            label = "MACRO_NO";
        }; // の

        // --- は行 ---

        // H + A (は)
        macro_ha: macro_ha {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp H &kp A>;
            label = "MACRO_HA";
        }; // は

        // H + I (ひ)
        macro_hi: macro_hi {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp H &kp I>;
            label = "MACRO_HI";
        }; // ひ

        // H + U (ふ)
        macro_hu: macro_hu {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp H &kp U>;
            label = "MACRO_HU";
        }; // ふ

        // H + E (へ)
        macro_he: macro_he {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp H &kp E>;
            label = "MACRO_HE";
        }; // へ

        // H + O (ほ)
        macro_ho: macro_ho {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp H &kp O>;
            label = "MACRO_HO";
        }; // ほ

        // --- ま行 ---

        // M + A (ま)
        macro_ma: macro_ma {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp M &kp A>;
            label = "MACRO_MA";
        }; // ま

        // M + I (み)
        macro_mi: macro_mi {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp M &kp I>;
            label = "MACRO_MI";
        }; // み

        // M + U (む)
        macro_mu: macro_mu {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp M &kp U>;
            label = "MACRO_MU";
        }; // む

        // M + E (め)
        macro_me: macro_me {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp M &kp E>;
            label = "MACRO_ME";
        }; // め

        // M + O (も)
        macro_mo: macro_mo {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp M &kp O>;
            label = "MACRO_MO";
        }; // も

        // --- や行 ---

        // Y + A (や)
        macro_ya: macro_ya {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp Y &kp A>;
            label = "MACRO_YA";
        }; // や

        // Y + U (ゆ)
        macro_yu: macro_yu {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp Y &kp U>;
            label = "MACRO_YU";
        }; // ゆ

        // Y + O (よ)
        macro_yo: macro_yo {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp Y &kp O>;
            label = "MACRO_YO";
        }; // よ

        // --- ら行 ---

        // R + A (ら)
        macro_ra: macro_ra {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp R &kp A>;
            label = "MACRO_RA";
        }; // ら

        // R + I (り)
        macro_ri: macro_ri {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp R &kp I>;
            label = "MACRO_RI";
        }; // り

        // R + U (る)
        macro_ru: macro_ru {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp R &kp U>;
            label = "MACRO_RU";
        }; // る

        // R + E (れ)
        macro_re: macro_re {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp R &kp E>;
            label = "MACRO_RE";
        }; // れ

        // R + O (ろ)
        macro_ro: macro_ro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp R &kp O>;
            label = "MACRO_RO";
        }; // ろ

        // --- わ行・ん ---

        // W + A (わ)
        macro_wa: macro_wa {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp W &kp A>;
            label = "MACRO_WA";
        }; // わ

        // W + O (を)
        macro_wo: macro_wo {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp W &kp O>;
            label = "MACRO_WO";
        }; // を

        // N + N (ん)
        macro_nn: macro_nn {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp N &kp N>;
            label = "MACRO_NN";
        }; // ん











        macro_yi: macro_yi {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp Y &kp I>;
            label = "MACRO_YI";
        }; // Y + I (い)

        macro_me: macro_me {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp M &kp E>;
            label = "MACRO_ME";
        }; // M + E (め)

        macro_pa: macro_pa {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp P &kp A>;
            label = "MACRO_PA";
        }; // P + A (ぱ)

        macro_ha: macro_ha {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp H &kp A>;
            label = "MACRO_HA";
        }; // H + A (は)

        macro_na: macro_na {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp N &kp A>;
            label = "MACRO_NA";
        }; // N + A (な)

        macro_to: macro_to {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp T &kp O>;
            label = "MACRO_TO";
        }; // T + O (と)

        macro_si: macro_si {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp S &kp I>;
            label = "MACRO_SI";
        }; // S + I (し)

        macro_ke: macro_ke {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp K &kp E>;
            label = "MACRO_KE";
        }; // K + E (け)

        macro_ju: macro_ju {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp J &kp U>;
            label = "MACRO_JU";
        }; // J + U (じゅ)

        macro_ga: macro_ga {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp G &kp A>;
            label = "MACRO_GA";
        }; // G + A (が)

        macro_bu: macro_bu {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp B &kp U>;
            label = "MACRO_BU";
        }; // B + U (ぶ)

        macro_di: macro_di {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp D &kp I>;
            label = "MACRO_DI";
        }; // D + I (ぢ)

        macro_ze: macro_ze {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp Z &kp E>;
            label = "MACRO_ZE";
        }; // Z + E (ぜ)

    };



    combos {
        compatible = "zmk,combos";

        // --- Cygnus 既存のコンボ ---
        // 物理20(N)と物理21(M)の同時押しでダブルクォーテーション(")を出力

        double_quotation {
            bindings = <&kp DOUBLE_QUOTES>;
            key-positions = <20 21>;
        };

        // =============================================================
        // 風神配列：子音キー + Space (38) の全コンボ定義 (レイヤー7限定)
        //
        // 【各属性の説明】
        // - timeout-ms = <50>;       : 2つのキーを50ミリ秒以内に押した場合に同時押しと判定
        // - key-positions = <X 38>;  : 対象の物理キー位置(X)とSpaceキー(38)の組み合わせ
        // - bindings = <&macro_xx>;   : 条件を満たした時に実行するマクロ（2文字一括出力）
        // - layers = <COFFEE_BASE>;  : 風神配列モード（レイヤー7）の時のみこのコンボを有効化
        // - slow-release;            : Space(38)が先に押された場合はコンボを解除し、
        //                              母音レイヤー（単体母音「あ」「い」等）を優先出力する
        // =============================================================

        // --- 上段 (Top Row) ---

        combo_q_spc {
            timeout-ms = <50>;
            key-positions = <0 38>;
            bindings = <&macro_me>;
            layers = <COFFEE_BASE>;
            slow-release;
        }; // Q(0) + Space(38) -> め

        combo_w_spc {
            timeout-ms = <50>;
            key-positions = <1 38>;
            bindings = <&macro_yi>;
            layers = <COFFEE_BASE>;
            slow-release;
        }; // W(1) + Space(38) -> い

        combo_e_spc {
            timeout-ms = <50>;
            key-positions = <2 38>;
            bindings = <&macro_ro>;
            layers = <COFFEE_BASE>;
            slow-release;
        }; // E(2) + Space(38) -> ろ

        combo_r_spc {
            timeout-ms = <50>;
            key-positions = <3 38>;
            bindings = <&macro_wa>;
            layers = <COFFEE_BASE>;
            slow-release;
        }; // R(3) + Space(38) -> わ

        combo_t_spc {
            timeout-ms = <50>;
            key-positions = <4 38>;
            bindings = <&macro_pa>;
            layers = <COFFEE_BASE>;
            slow-release;
        }; // T(4) + Space(38) -> ぱ

        combo_y_spc {
            timeout-ms = <50>;
            key-positions = <5 38>;
            bindings = <&macro_xa>;
            layers = <COFFEE_BASE>;
            slow-release;
        }; // Y(5) + Space(38) -> ぁ

        // --- 中段 (Home Row) ---

        combo_a_spc {
            timeout-ms = <50>;
            key-positions = <12 38>;
            bindings = <&macro_ke>;
            layers = <COFFEE_BASE>;
            slow-release;
        }; // A(12) + Space(38) -> け

        combo_s_spc {
            timeout-ms = <50>;
            key-positions = <13 38>;
            bindings = <&macro_si>;
            layers = <COFFEE_BASE>;
            slow-release;
        }; // S(13) + Space(38) -> し

        combo_d_spc {
            timeout-ms = <50>;
            key-positions = <14 38>;
            bindings = <&macro_to>;
            layers = <COFFEE_BASE>;
            slow-release;
        }; // D(14) + Space(38) -> と

        combo_f_spc {
            timeout-ms = <50>;
            key-positions = <15 38>;
            bindings = <&macro_na>;
            layers = <COFFEE_BASE>;
            slow-release;
        }; // F(15) + Space(38) -> な

        combo_g_spc {
            timeout-ms = <50>;
            key-positions = <16 38>;
            bindings = <&macro_ha>;
            layers = <COFFEE_BASE>;
            slow-release;
        }; // G(16) + Space(38) -> は

        // --- 下段 (Bottom Row) ---

        combo_z_spc {
            timeout-ms = <50>;
            key-positions = <24 38>;
            bindings = <&macro_ze>;
            layers = <COFFEE_BASE>;
            slow-release;
        }; // Z(24) + Space(38) -> ぜ

        combo_x_spc {
            timeout-ms = <50>;
            key-positions = <25 38>;
            bindings = <&macro_di>;
            layers = <COFFEE_BASE>;
            slow-release;
        }; // X(25) + Space(38) -> ぢ

        combo_c_spc {
            timeout-ms = <50>;
            key-positions = <26 38>;
            bindings = <&macro_bu>;
            layers = <COFFEE_BASE>;
            slow-release;
        }; // C(26) + Space(38) -> ぶ

        combo_v_spc {
            timeout-ms = <50>;
            key-positions = <27 38>;
            bindings = <&macro_ga>;
            layers = <COFFEE_BASE>;
            slow-release;
        }; // V(27) + Space(38) -> が

        combo_b_spc {
            timeout-ms = <50>;
            key-positions = <28 38>;
            bindings = <&macro_ju>;
            layers = <COFFEE_BASE>;
            slow-release;
        }; // B(28) + Space(38) -> じゅ

        // =============================================================
        // 風神配列：文字キー同士の同時代行・ロールオーバーコンボ
        // AHK版の機能再現用（親指無変換キーやSキーとの組み合せ）
        // =============================================================

        // 子音C(26) + 左親指無変換キー(35) の同時押し -> 「ぶ」(BU) を出力

        combo_c_muhenkan {
            timeout-ms = <50>;
            key-positions = <26 35>;
            bindings = <&macro_bu>;
            layers = <COFFEE_BASE>;
        };

        // 子音B(28) + 左親指無変換キー(35) の同時押し -> 「じゅ」(JU) を出力

        combo_b_muhenkan {
            timeout-ms = <50>;
            key-positions = <28 35>;
            bindings = <&macro_ju>;
            layers = <COFFEE_BASE>;
        };

        // 子音C(26) + Sキー(13) の同時押し -> 「ぶ」(BU) を出力

        combo_c_s {
            timeout-ms = <50>;
            key-positions = <26 13>;
            bindings = <&macro_bu>;
            layers = <COFFEE_BASE>;
        };

        // 子音B(28) + Sキー(13) の同時押し -> 「じゅ」(JU) を出力

        combo_b_s {
            timeout-ms = <50>;
            key-positions = <28 13>;
            bindings = <&macro_ju>;
            layers = <COFFEE_BASE>;
        };
    };



    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        ROTATE: ROTATE {
            compatible = "zmk,behavior-sensor-rotate-var";
            label = "ROTATE";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;

            tap-ms = <20>;
        };

        // 風神配列用：Space長押しでCOFFEE_VOWEL(8)、TapでSpace出力

        lt_spc: lt_spc {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_SPACE";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&mo>, <&kp>;
        };
    };



    keymap {
        compatible = "zmk,keymap";

        // -------------------------------------------------------------
        // レイヤー 0: デフォルト (QWERTY)
        // ※ 右下キー（tog 7）で風神配列（レイヤー7）へトグル切替
        // -------------------------------------------------------------

        default_layer {
            bindings = <
&kp Q             &kp W         &kp E         &kp R                  &kp T                                                   &kp Y        &kp U  &kp I      &kp O    &kp P
&kp A             &kp S         &kp D         &kp F                  &kp G        &mkp RCLK                  &kp UP_ARROW    &kp H        &kp J  &kp K      &lt 4 L  &lt 5 MINUS
&mt LEFT_SHIFT Z  &kp X         &kp C         &kp V                  &kp B        &mkp LCLK                  &kp DOWN_ARROW  &kp N        &kp M  &kp COMMA  &kp DOT  &mt LEFT_SHIFT SLASH
&kp LCTRL         &kp LEFT_WIN  &kp LEFT_ALT  &lt 6 INTERNATIONAL_4  &lt 1 SPACE  &lt 3 INTERNATIONAL_5      &kp BACKSPACE   &lt 2 ENTER                             &tog 7
            >;

            sensor-bindings = <&ROTATE SCRL_DOWN SCRL_UP>;
        };

        // -------------------------------------------------------------
        // レイヤー 1〜6: roBa オリジナルレイヤー
        // -------------------------------------------------------------

        FUNCTION {
            bindings = <
&kp F1   &kp F2  &kp F3  &kp F4  &kp F5                        &kp F1  &kp F2  &kp F3  &kp F4  &kp F5
&kp F6   &kp F7  &kp F8  &kp F9  &kp F10  &trans      &kp F13  &kp F6  &kp F7  &kp F8  &kp F9  &kp F10
&kp F11  &trans  &trans  &trans  &trans   &trans      &trans   &trans  &trans  &trans  &trans  &kp F11
&kp F12  &trans  &trans  &trans  &trans   &trans      &trans   &trans                          &kp F12
            >;
        };

        NUM {
            bindings = <
&kp MINUS                   &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp PLUS                                     &kp CARET         &kp AMPERSAND      &kp TILDE       &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS
&kp SLASH                   &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp ASTERISK  &trans         &kp UNDERSCORE  &kp EXCLAMATION   &kp AT_SIGN        &kp HASH        &kp DOLLAR            &kp PERCENT
&mt LEFT_SHIFT KP_NUMBER_0  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp PERIOD    &kp EQUAL      &trans          &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp LEFT_BRACE  &kp RIGHT_BRACE       &kp BACKSLASH
&trans                      &trans           &trans           &trans           &trans        &trans         &trans          &trans                                                                     &kp PIPE
            >;
        };

        ARROW {
            bindings = <
&kp ESCAPE      &kp LC(LS(TAB))         &kp UP_ARROW    &kp LC(TAB)              &trans                       &trans  &trans  &trans  &trans  &trans
&kp HOME        &kp LEFT_ARROW          &kp DOWN_ARROW  &kp RIGHT_ARROW          &kp END  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&kp LEFT_SHIFT  &kp LG(LS(LEFT_ARROW))  &trans          &kp LG(LS(RIGHT_ARROW))  &trans   &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans          &trans                  &trans          &trans                   &trans   &trans      &trans  &trans                          &trans
            >;

            sensor-bindings = <&inc_dec_kp LC(PAGE_UP) LC(PAGE_DOWN)>;
        };

        MOUSE {
            bindings = <
&trans       &trans       &kp LC(PAGE_UP)  &kp LC(PAGE_DOWN)  &kp LC(W)                         &kp LC(W)  &kp LC(PAGE_UP)  &kp LC(PAGE_DOWN)  &trans       &trans
&lt 5 SPACE  &lt 4 SPACE  &mkp LCLK        &mkp RCLK          &mkp MCLK  &mkp RCLK      &trans  &mkp MCLK  &mkp LCLK        &mkp RCLK          &lt 4 SPACE  &lt 5 SPACE
&trans       &trans       &trans           &trans             &trans     &mkp LCLK      &trans  &trans     &mkp MB4         &mkp MB5           &trans       &trans
&trans       &trans       &trans           &trans             &trans     &trans         &trans  &trans                                                      &trans
            >;
        };

        SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&none   &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };

        layer_6 {
            bindings = <
&trans  &trans        &trans        &trans        &trans                                 &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans  &trans        &trans        &trans        &trans     &trans      &studio_unlock  &trans        &trans        &trans        &trans        &trans
&trans  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kt KP_N4  &trans      &bootloader     &trans        &trans        &trans        &trans        &bt BT_CLR
&trans  &trans        &trans        &trans        &trans     &trans      &trans          &trans                                                  &bt BT_CLR_ALL
            >;
        };

        // -------------------------------------------------------------
        // レイヤー 7: 珈琲・子音レイヤー (COFFEE_BASE)
        // -------------------------------------------------------------

        COFFEE_BASE {
            bindings = <
&trans  &trans  &trans  &trans  &trans                         &kp W                       &kp R  &kp Y  &kp M  &kp P
&trans  &trans  &trans  &trans  &trans  &trans      &kp H      &kp N                       &kp T  &kp S  &kp K  &kp RCTRL
&trans  &trans  &trans  &trans  &trans  &trans      &kp J      &kp G                       &kp B  &kp D  &kp Z  &kp RSHFT
&trans  &trans  &trans  &trans  &trans  &trans      &kp ENTER  &lt_spc COFFEE_VOWEL SPACE                       &tog 0
            >;
        };

        // -------------------------------------------------------------
        // レイヤー 8: 珈琲・母音レイヤー (COFFEE_VOWEL)
        // -------------------------------------------------------------

        COFFEE_VOWEL {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &kp U   &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &kp O   &kp A   &kp I   &kp E   &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };
    };
};
