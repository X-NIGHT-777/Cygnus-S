    combos {
        compatible = "zmk,combos";

        // --- Cygnus 既存のコンボ ---
        // 物理20(N)と物理21(M)の同時押しでダブルクォーテーション(")を出力

        double_quotation {
            bindings = <&kp DOUBLE_QUOTES>;
            key-positions = <20 21>;
        };

        // =============================================================
        // 風神配列：子音キー + Space (38) の全コンボ定義 (レイヤー7限定)
        //
        // 【各属性の説明】
        // - timeout-ms = <50>;       : 2つのキーを50ミリ秒以内に押した場合に同時押しと判定
        // - key-positions = <X 38>;  : 対象の物理キー位置(X)とSpaceキー(38)の組み合わせ
        // - bindings = <&macro_xx>;   : 条件を満たした時に実行するマクロ（2文字一括出力）
        // - layers = <COFFEE_BASE>;  : 風神配列モード（レイヤー7）の時のみこのコンボを有効化
        // - slow-release;            : Space(38)が先に押された場合はコンボを解除し、
        //                              母音レイヤー（単体母音「あ」「い」等）を優先出力する
        // =============================================================

        // --- 上段 (Top Row) ---

        // W(6) + T(18) -> わ
        combo_w_t {
            timeout-ms = <50>;
            key-positions = <6 18>;
            bindings = <&macro_wa>;
            layers = <COFFEE_BASE>;
        };





        // --- 中段 (Home Row) ---

        // N(17) + T(18) -> な
        combo_n_t {
            timeout-ms = <50>;
            key-positions = <17 18>;
            bindings = <&macro_na>;
            layers = <COFFEE_BASE>;
        };

        // N(17) + Space(40) -> の
        combo_n_space {
            timeout-ms = <50>;
            key-positions = <17 40>;
            bindings = <&macro_no>;
            layers = <COFFEE_BASE>;
            slow-release;
        };





        // --- 下段 (Bottom Row) ---














        // =============================================================
        // 風神配列：文字キー同士の同時代行・ロールオーバーコンボ
        // AHK版の機能再現用（親指無変換キーやSキーとの組み合せ）
        // =============================================================

        // 子音C(26) + 左親指無変換キー(35) の同時押し -> 「ぶ」(BU) を出力

        combo_c_muhenkan {
            timeout-ms = <50>;
            key-positions = <26 35>;
            bindings = <&macro_bu>;
            layers = <COFFEE_BASE>;
        };

        // 子音B(28) + 左親指無変換キー(35) の同時押し -> 「じゅ」(JU) を出力

        combo_b_muhenkan {
            timeout-ms = <50>;
            key-positions = <28 35>;
            bindings = <&macro_ju>;
            layers = <COFFEE_BASE>;
        };

        // 子音C(26) + Sキー(13) の同時押し -> 「ぶ」(BU) を出力

        combo_c_s {
            timeout-ms = <50>;
            key-positions = <26 13>;
            bindings = <&macro_bu>;
            layers = <COFFEE_BASE>;
        };

        // 子音B(28) + Sキー(13) の同時押し -> 「じゅ」(JU) を出力

        combo_b_s {
            timeout-ms = <50>;
            key-positions = <28 13>;
            bindings = <&macro_ju>;
            layers = <COFFEE_BASE>;
        };
    };



    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        ROTATE: ROTATE {
            compatible = "zmk,behavior-sensor-rotate-var";
            label = "ROTATE";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;

            tap-ms = <20>;
        };

        // 風神配列用：Space長押しでCOFFEE_VOWEL(8)、TapでSpace出力

        lt_spc: lt_spc {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_SPACE";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&mo>, <&kp>;
        };
    };



    keymap {
        compatible = "zmk,keymap";

        // -------------------------------------------------------------
        // レイヤー 0: デフォルト (QWERTY)
        // ※ 右下キー（tog 7）で風神配列（レイヤー7）へトグル切替
        // -------------------------------------------------------------

        default_layer {
            bindings = <
&kp Q             &kp W         &kp E         &kp R                  &kp T                                                   &kp Y        &kp U  &kp I      &kp O    &kp P
&kp A             &kp S         &kp D         &kp F                  &kp G        &mkp RCLK                  &kp UP_ARROW    &kp H        &kp J  &kp K      &lt 4 L  &lt 5 MINUS
&mt LEFT_SHIFT Z  &kp X         &kp C         &kp V                  &kp B        &mkp LCLK                  &kp DOWN_ARROW  &kp N        &kp M  &kp COMMA  &kp DOT  &mt LEFT_SHIFT SLASH
&kp LCTRL         &kp LEFT_WIN  &kp LEFT_ALT  &lt 6 INTERNATIONAL_4  &lt 1 SPACE  &lt 3 INTERNATIONAL_5      &kp BACKSPACE   &lt 2 ENTER                             &tog 7
            >;

            sensor-bindings = <&ROTATE SCRL_DOWN SCRL_UP>;
        };

        // -------------------------------------------------------------
        // レイヤー 1〜6: roBa オリジナルレイヤー
        // -------------------------------------------------------------

        FUNCTION {
            bindings = <
&kp F1   &kp F2  &kp F3  &kp F4  &kp F5                        &kp F1  &kp F2  &kp F3  &kp F4  &kp F5
&kp F6   &kp F7  &kp F8  &kp F9  &kp F10  &trans      &kp F13  &kp F6  &kp F7  &kp F8  &kp F9  &kp F10
&kp F11  &trans  &trans  &trans  &trans   &trans      &trans   &trans  &trans  &trans  &trans  &kp F11
&kp F12  &trans  &trans  &trans  &trans   &trans      &trans   &trans                          &kp F12
            >;
        };

        NUM {
            bindings = <
&kp MINUS                   &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp PLUS                                     &kp CARET         &kp AMPERSAND      &kp TILDE       &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS
&kp SLASH                   &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp ASTERISK  &trans         &kp UNDERSCORE  &kp EXCLAMATION   &kp AT_SIGN        &kp HASH        &kp DOLLAR            &kp PERCENT
&mt LEFT_SHIFT KP_NUMBER_0  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp PERIOD    &kp EQUAL      &trans          &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp LEFT_BRACE  &kp RIGHT_BRACE       &kp BACKSLASH
&trans                      &trans           &trans           &trans           &trans        &trans         &trans          &trans                                                                     &kp PIPE
            >;
        };

        ARROW {
            bindings = <
&kp ESCAPE      &kp LC(LS(TAB))         &kp UP_ARROW    &kp LC(TAB)              &trans                       &trans  &trans  &trans  &trans  &trans
&kp HOME        &kp LEFT_ARROW          &kp DOWN_ARROW  &kp RIGHT_ARROW          &kp END  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&kp LEFT_SHIFT  &kp LG(LS(LEFT_ARROW))  &trans          &kp LG(LS(RIGHT_ARROW))  &trans   &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans          &trans                  &trans          &trans                   &trans   &trans      &trans  &trans                          &trans
            >;

            sensor-bindings = <&inc_dec_kp LC(PAGE_UP) LC(PAGE_DOWN)>;
        };

        MOUSE {
            bindings = <
&trans       &trans       &kp LC(PAGE_UP)  &kp LC(PAGE_DOWN)  &kp LC(W)                         &kp LC(W)  &kp LC(PAGE_UP)  &kp LC(PAGE_DOWN)  &trans       &trans
&lt 5 SPACE  &lt 4 SPACE  &mkp LCLK        &mkp RCLK          &mkp MCLK  &mkp RCLK      &trans  &mkp MCLK  &mkp LCLK        &mkp RCLK          &lt 4 SPACE  &lt 5 SPACE
&trans       &trans       &trans           &trans             &trans     &mkp LCLK      &trans  &trans     &mkp MB4         &mkp MB5           &trans       &trans
&trans       &trans       &trans           &trans             &trans     &trans         &trans  &trans                                                      &trans
            >;
        };

        SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&none   &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };

        layer_6 {
            bindings = <
&trans  &trans        &trans        &trans        &trans                                 &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans  &trans        &trans        &trans        &trans     &trans      &studio_unlock  &trans        &trans        &trans        &trans        &trans
&trans  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kt KP_N4  &trans      &bootloader     &trans        &trans        &trans        &trans        &bt BT_CLR
&trans  &trans        &trans        &trans        &trans     &trans      &trans          &trans                                                  &bt BT_CLR_ALL
            >;
        };

        // -------------------------------------------------------------
        // レイヤー 7: 珈琲・子音レイヤー (COFFEE_BASE)
        // -------------------------------------------------------------

        COFFEE_BASE {
            bindings = <
&trans  &trans  &trans  &trans  &trans                         &kp W                       &kp R  &kp Y  &kp M  &kp P
&trans  &trans  &trans  &trans  &trans  &trans      &kp H      &kp N                       &kp T  &kp S  &kp K  &kp RCTRL
&trans  &trans  &trans  &trans  &trans  &trans      &kp J      &kp G                       &kp B  &kp D  &kp Z  &kp RSHFT
&trans  &trans  &trans  &trans  &trans  &trans      &kp ENTER  &lt_spc COFFEE_VOWEL SPACE                       &tog 0
            >;
        };

        // -------------------------------------------------------------
        // レイヤー 8: 珈琲・母音レイヤー (COFFEE_VOWEL)
        // -------------------------------------------------------------

        COFFEE_VOWEL {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &kp U   &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &kp O   &kp A   &kp I   &kp E   &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };
    };
};
